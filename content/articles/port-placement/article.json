    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Internal jugular vein:"
                  },
                  " commonly used for chest ports; map its relationship to the carotid with ultrasound."
                ],
                [
                  {
                    "strong": "Central venous route:"
                  },
                  " confirm a patent path through the brachiocephalic vein into the SVC."
                ],
                [
                  {
                    "strong": "Catheter tip:"
                  },
                  " generally targets the lower SVC/cavoatrial junction; avoid deep intracardiac positioning."
                ],
                [
                  {
                    "strong": "Port pocket:"
                  },
                  " place in healthy subcutaneous chest tissue with adequate coverage and an accessible septum."
                ],
                [
                  {
                    "strong": "Tunnel:"
                  },
                  " use a smooth course without sharp bends; a medial subclavian route risks costoclavicular compression."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Plan the vein and pocket"
                  },
                  " considering patency, skin condition, prior devices, and treatment needs."
                ],
                [
                  {
                    "strong": "2. Prep, anesthetize, and access"
                  },
                  " the vein under ultrasound with full sterile precautions; confirm venous wire position."
                ],
                [
                  {
                    "strong": "3. Create the pocket and tunnel"
                  },
                  " with a smooth catheter course and enough tissue to cover the reservoir."
                ],
                [
                  {
                    "strong": "4. Position and connect the catheter"
                  },
                  " using fluoroscopy to set tip depth; trim and assemble per device instructions."
                ],
                [
                  {
                    "strong": "5. Confirm function"
                  },
                  " by aspirating blood and flushing through a noncoring needle; check for kinks, leaks, and tip position."
                ],
                [
                  {
                    "strong": "6. Secure, close, and document"
                  },
                  " hemostasis, final imaging, device details, and readiness for use; lock per local protocol."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Arterial access:"
                      },
                      " confirm vein and wire before dilation; large-bore arterial cannulation needs specialist management before removal."
                    ],
                    [
                      {
                        "strong": "Air embolism:"
                      },
                      " keep hubs occluded and minimize open-sheath time during catheter insertion."
                    ],
                    [
                      {
                        "strong": "Arrhythmia or perforation:"
                      },
                      " avoid excessive intracardiac wire or catheter advancement; reassess new ectopy or instability."
                    ],
                    [
                      {
                        "strong": "Pneumothorax:"
                      },
                      " keep the access needle visualized; assess new chest pain, hypoxia, or respiratory distress."
                    ],
                    [
                      {
                        "strong": "Malfunction:"
                      },
                      " correct kinking, malposition, or a loose connection before closure; never force a resistant flush."
                    ],
                    [
                      {
                        "strong": "Pocket complications:"
                      },
                      " achieve hemostasis and avoid excessive tension, thin coverage, or infected skin."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
