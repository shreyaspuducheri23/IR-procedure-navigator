  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Selected primary lung tumors or pulmonary metastases for local treatment after multidisciplinary review.",
                "Patients unsuitable for surgery or other local therapy."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Uncorrectable coagulopathy or uncontrolled infection.",
                    "No safe probe path or inability to protect adjacent structures.",
                    "Insufficient lung reserve or inability to tolerate the planned procedure (relative)."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: hold 5 days and confirm INR <= 1.8.",
                    "IV unfractionated heparin: hold 4-6 hours and check aPTT or anti-Xa.",
                    "Enoxaparin: hold 1 dose if prophylactic; hold 2 doses or 24 hours if therapeutic.",
                    "DOACs: use agent- and CrCl-specific timing in the anticoagulation table.",
                    "Clopidogrel: hold 5 days.",
                    "Aspirin: hold 3-5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50,000/µL."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "SDC/Outpatient with Discharge OR bedded outpatient; no discharge order if admitting.",
                "NPO for anesthesia.",
                "Peripheral line placement.",
                "Vital signs per routine.",
                "Glucose point of care.",
                "Cefazolin (Ancef) 2 g if <120 kg; 3 g if >120 kg. Confirm dose at 120 kg per protocol.",
                "CBC and INR within 30 days."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " General anesthesia; coordinate ventilation and breath holds with anesthesia."
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication."
                  },
                  ""
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " target size/location, fissures, bullae, vessels, and safe pleural entry."
                ],
                [
                  {
                    "strong": "Confirm recovery plan:"
                  },
                  " pulmonary reserve, oxygen needs, and chest-tube equipment/admission availability."
                ],
                [
                  {
                    "strong": "Confirm ablation plan:"
                  },
                  " modality, probe configuration, treatment margin, and protection of nearby structures."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " confirm results meet procedure-specific requirements when indicated; see the Labs tab."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm the procedure-specific hold/continue plan; see the Anticoagulation tab."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " discuss the procedure and patient-specific risks; identify a surrogate if needed."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
            {
              "type": "heading",
              "text": "Procedure"
            },
            {
              "type": "list",
              "items": [
                "Lung Ablation"
              ]
            },
            {
              "type": "heading",
              "text": "Common risks"
            },
            {
              "type": "list",
              "items": [
                "Infection.",
                "Bleeding.",
                "Injury to nearby structures.",
                "Need for repeat treatment."
              ]
            },
            {
              "type": "heading",
              "text": "Procedure-specific risks"
            },
            {
              "type": "list",
              "items": [
                "Pneumothorax requiring chest tube.",
                "Hemoptysis or air embolism."
              ]
            },
            {
              "type": "heading",
              "text": "Consent discussion"
            },
            {
              "type": "list",
              "items": [
                "Discuss the expected benefit, alternatives, and patient-specific risks. This risk summary supports the discussion and institutional consent form; it is not an exhaustive consent document."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Target:"
                  },
                  " relationship to pleura, fissures, bronchi, and pulmonary vessels."
                ],
                [
                  {
                    "strong": "Nearby structures:"
                  },
                  " diaphragm, mediastinum, chest wall, and intercostal neurovascular bundle."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "callout",
              "variant": "note",
              "title": "Quick steps",
              "collapsible": true,
              "defaultOpen": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic steps"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Position and plan:"
                      },
                      " confirm the target on CT/US and select safe probe paths."
                    ],
                    [
                      {
                        "strong": "2. Prep and protect:"
                      },
                      " prep, drape, and anesthetize; minimize pleural punctures and avoid fissures, bullae, major vessels, and central airways."
                    ],
                    [
                      {
                        "strong": "3. Place probes:"
                      },
                      " advance under imaging and confirm configuration across the target and planned margin."
                    ],
                    [
                      {
                        "strong": "4. Ablate:"
                      },
                      " use the selected device protocol; coordinate ventilation; monitor the ablation zone, pleura, and nearby structures on CT."
                    ],
                    [
                      {
                        "strong": "5. Reassess:"
                      },
                      " confirm target coverage and assess for bleeding or adjacent-organ injury; treat residual target if safe."
                    ],
                    [
                      {
                        "strong": "6. Finish:"
                      },
                      " remove probes per device protocol, confirm hemostasis, and save final imaging; assess for pneumothorax and hemorrhage."
                    ]
                  ]
                }
              ]
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "Detailed steps",
              "collapsible": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Content pending."
                }
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Pneumothorax:"
                      },
                      " reassess during and after treatment; drain if clinically indicated."
                    ],
                    [
                      {
                        "strong": "Hemorrhage or air embolism:"
                      },
                      " stop and assess new hemoptysis, hypoxia, neurologic change, or instability immediately."
                    ],
                    [
                      {
                        "strong": "Airway injury:"
                      },
                      " avoid unprotected central bronchi and reassess proximity during treatment."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
