    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Thyroid lobes and isthmus:"
                  },
                  " sit anterior and lateral to the trachea beneath the strap muscles."
                ],
                [
                  {
                    "strong": "Carotid and jugular:"
                  },
                  " lie lateral to the gland; map them before choosing the tract."
                ],
                [
                  {
                    "strong": "Thyroid vessels:"
                  },
                  " use Doppler to avoid vessels along the route and within the nodule."
                ],
                [
                  {
                    "strong": "Posterior danger zone:"
                  },
                  " the esophagus and recurrent laryngeal nerve region lie behind the gland; avoid overshooting the capsule."
                ],
                [
                  {
                    "strong": "Nodule target:"
                  },
                  " sample the suspicious solid component rather than cyst fluid alone."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Confirm the correct nodule"
                  },
                  " against prior imaging; document side, location, and size."
                ],
                [
                  {
                    "strong": "2. Position and scan"
                  },
                  " supine with comfortable neck extension; map vessels and choose a visible needle path."
                ],
                [
                  {
                    "strong": "3. Prep and anesthetize"
                  },
                  " as needed; ask the patient to avoid swallowing or talking during each pass."
                ],
                [
                  {
                    "strong": "4. Sample under ultrasound"
                  },
                  " keeping the tip visible within the solid target; use short controlled FNA movements."
                ],
                [
                  {
                    "strong": "5. Check specimen adequacy"
                  },
                  " with on-site cytology when available; sample additional areas as needed and label each nodule separately."
                ],
                [
                  {
                    "strong": "6. Apply pressure and reassess"
                  },
                  " for swelling, bleeding, voice change, or breathing difficulty before discharge."
                ]
              ]
            },
            {
              "type": "heading",
              "text": "If core biopsy is selected"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm a safe throw:"
                  },
                  " keep the entire sampling notch and needle excursion within the planned target, clear of posterior structures."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Wrong nodule:"
                      },
                      " match landmarks and labels, especially in a multinodular gland."
                    ],
                    [
                      {
                        "strong": "Nondiagnostic sample:"
                      },
                      " target solid tissue; cyst fluid or heavily calcified areas may yield few cells."
                    ],
                    [
                      {
                        "strong": "Bloody aspirate:"
                      },
                      " reduce suction and avoid visible vessels; excess blood can obscure cytology."
                    ],
                    [
                      {
                        "strong": "Lost needle tip:"
                      },
                      " stop and regain visualization before advancing or sampling."
                    ],
                    [
                      {
                        "strong": "Neck hematoma:"
                      },
                      " apply pressure; rapidly expanding swelling, dysphagia, or dyspnea requires urgent airway assessment."
                    ],
                    [
                      {
                        "strong": "Voice change or deep pain:"
                      },
                      " stop and assess for posterior injury or hematoma; avoid overshooting the gland."
                    ]
                  ]
                },
                {
