        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "heading",
              "text": "Thoracentesis"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Pleural space:"
                  },
                  " fluid lies between parietal and visceral pleura; confirm a true pocket rather than consolidated lung."
                ],
                [
                  {
                    "strong": "Lung and diaphragm:"
                  },
                  " identify lung excursion above and the diaphragm below throughout respiration."
                ],
                [
                  {
                    "strong": "Below the diaphragm:"
                  },
                  " the liver is right-sided and the spleen is left-sided; keep both outside the planned tract."
                ],
                [
                  {
                    "strong": "Intercostal bundle:"
                  },
                  " the vein, artery, and nerve run along the inferior rib margin; enter over the superior rib margin."
                ],
                [
                  {
                    "strong": "Complex effusions:"
                  },
                  " loculations, adhesions, and non-expandable lung can limit drainage and change the expected result."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Thoracentesis"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm the plan:"
                  },
                  " side, diagnostic versus therapeutic goal, specimen studies, and intended drainage volume."
                ],
                [
                  {
                    "strong": "Map the pocket:"
                  },
                  " scan in the procedure position and mark fluid depth, lung, diaphragm, and adjacent organs."
                ],
                [
                  {
                    "strong": "Choose the tract:"
                  },
                  " typical landmarks are the 6th-8th intercostal spaces at the midaxillary line (supine) or posterior midscapular line (seated). Ultrasound determines the safe site above the diaphragm; use Doppler as needed and enter over the superior rib margin."
                ],
                [
                  {
                    "strong": "Prep and anesthetize:"
                  },
                  " extend local anesthesia to the parietal pleura and confirm fluid return."
                ],
                [
                  {
                    "strong": "Place the catheter:"
                  },
                  " advance into the pleural space without forcing it and collect diagnostic samples first."
                ],
                [
                  {
                    "strong": "Drain slowly:"
                  },
                  " use manual aspiration or gravity rather than vacuum bottles or wall suction."
                ],
                [
                  {
                    "strong": "Stop for symptoms:"
                  },
                  " end drainage for chest tightness, pain, persistent cough, or worsening breathlessness; document volume and appearance."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "heading",
                  "text": "Thoracentesis"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "No safe pocket:"
                      },
                      " do not use landmarks alone; reposition or use real-time ultrasound for small or loculated fluid."
                    ],
                    [
                      {
                        "strong": "Pneumothorax:"
                      },
                      " keep the needle tip controlled and reassess new dyspnea, hypoxia, or chest pain."
                    ],
                    [
                      {
                        "strong": "Bleeding:"
                      },
                      " enter over the rib, avoid Doppler-visible vessels, and escalate bloody output with instability or an enlarging hematoma."
                    ],
                    [
                      {
                        "strong": "Organ injury:"
                      },
                      " confirm the diaphragm and abdominal organs before access, especially with a small or subpulmonic effusion."
                    ],
                    [
                      {
                        "strong": "Re-expansion symptoms:"
                      },
                      " drain slowly, generally limit one attempt to 1.5 L, and stop for pain, cough, tightness, or breathlessness."
                    ],
                    [
                      {
                        "strong": "Non-expandable lung:"
                      },
                      " a post-drainage pneumothorax may be ex vacuo; correlate with symptoms and imaging before reflex chest-tube placement."
                    ]
                  ]
                },
