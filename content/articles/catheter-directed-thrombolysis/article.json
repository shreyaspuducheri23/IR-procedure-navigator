  ],
  "summary": "Catheter-directed thrombolysis guidance for acute limb ischemia, threatening iliofemoral DVT symptoms, phlegmasia, and acute thrombosed bypass graft.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm INR q5 versus q6 timing with the formal order set.",
    "Confirm exact heparin, alteplase, and saline defaults.",
    "Confirm required monitoring location and nursing requirements.",
    "Confirm next-day lysis check/removal order naming."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Use when thrombus acuity and symptoms justify catheter-directed lysis."
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Acute limb ischemia.",
                "Acute or subacute iliofemoral DVT with threatening limb symptoms.",
                "Phlegmasia cerulea dolens.",
                "Acute thrombosed bypass graft."
              ]
            }
          ]
        },
        {
          "id": "contraindications",
          "title": "Contraindications",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Exclude major bleeding, intracranial, neurologic, and severe hypertension risks before lysis."
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Active bleeding.",
                    "Recent intracranial hemorrhage.",
                    "Recent ischemic stroke.",
                    "Intracranial neoplasm/AVM.",
                    "Recent major intracranial or spinal surgery.",
                    "Severe uncontrolled hypertension."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Platelets >50k.",
                "INR <1.5-1.8.",
                "Fibrinogen."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding-risk procedure. Use the anticoagulation table for hold and restart timing."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding-risk procedure.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: 5 days.",
                    "Heparin: 6-8 hours.",
                    "Lovenox: 24 hours; hold 1 dose prior if prophylactic.",
                    "DOACs: 48 hours.",
                    "Plavix: 5 days.",
                    "Aspirin: 5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Moderate sedation or general anesthesia depending on patient acuity and airway/procedure needs."
            },
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                "General anesthesia."
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "checklist",
              "title": "Checklist",
              "items": [
                "Confirm indication.",
                "Labs are appropriate.",
                "Review imaging.",
                "Exclude contraindications."
              ]
            },
            {
              "type": "checklist",
              "title": "Pre-procedure orders",
              "items": [
                "Anti-Xa q6 x 24 hours.",
                "APTT q6 x 24 hours.",
                "CBC q6 x 24 hours.",
                "Fibrinogen q6 x 24 hours.",
                "INR q5 x 24 hours.",
                "Notify MD/LIP: Fibrinogen <200 mg/dL.",
                "Notify MD/LIP: APTT >50 sec.",
                "Notify MD/LIP: INR >1.7.",
                "Notify MD/LIP: Platelets <100,000/m3."
              ]
            },
            {
              "type": "checklist",
              "title": "One infusion catheter and sheath",
              "items": [
                "Heparin (FLAT RATE) at 500 units/hr: 1 order.",
                "Sodium chloride infusion 20 mL/hr: 1 order.",
                "Alteplase 1 mg/hr: 1 order."
              ]
            },
            {
              "type": "checklist",
              "title": "Two infusion catheters and sheaths (Site A and Site B)",
              "items": [
                "Heparin (FLAT RATE) at 250 units/hr: 2 orders.",
                "Sodium chloride infusion 20 mL/hr: 2 orders.",
                "Alteplase 0.5 mg/hr: 2 orders."
              ]
            },
            {
              "type": "checklist",
              "title": "Two infusion catheters through one sheath",
              "items": [
                "Heparin (FLAT RATE) at 500 units/hr: 1 order.",
                "Sodium chloride infusion 20 mL/hr: 2 orders.",
                "Alteplase 0.5 mg/hr: 2 orders."
              ]
            }
          ]
        }
      ]
    },
    {
