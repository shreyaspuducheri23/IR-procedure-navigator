      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Unexplained AKI or progressive renal dysfunction.",
                "Nephrotic syndrome or significant/persistent proteinuria.",
                "Hematuria with proteinuria, impaired renal function, or suspected glomerulonephritis.",
                "Suspected systemic renal disease, such as lupus, vasculitis, or amyloidosis.",
                "Renal mass characterization or transplant dysfunction, including suspected rejection or recurrent disease."
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50k."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding risk; hold anticoagulants/antiplatelets per policy."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-guidelines"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: 5 days.",
                    "Heparin: 6-8 hours.",
                    "Lovenox: 24 hours; hold 1 dose prior if prophylactic.",
                    "DOACs: 48 hours.",
                    "Plavix: 5 days.",
                    "Aspirin: 5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Local, mostly."
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm indication, imaging window, labs, blood pressure, infection screen, kidney size, and specimen requests."
            },
            {
              "type": "list",
              "items": [
                "Confirm indication and review imaging with appropriate window.",
                "Labs are appropriate.",
                "Blood pressure is under control.",
                "No active UTI/pyelonephritis or skin infection over site.",
                "Kidneys are at least 9 cm, recommended.",
                "Specimen requests confirmed."
              ]
            }
          ]
        }
      ]
    },
