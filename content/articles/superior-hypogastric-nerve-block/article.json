  ],
  "summary": "Image-guided superior hypogastric plexus block for adjunct pain control during UFE.",
  "lastReviewed": null,
  "provenance": [],
  "reviewNotes": [],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Adjunct pain control during UFE to reduce pelvic pain and opioid requirements.",
                "Selected visceral pelvic pain when directed by the treating team; neurolysis requires a separate plan."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Uncorrected coagulopathy or anticoagulant effect incompatible with a deep plexus block.",
                    "Local infection or uncontrolled systemic infection.",
                    "No safe needle path around bowel, vessels, or other organs.",
                    "Local-anesthetic allergy without an alternative, or instability making the block unsafe."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "heading",
              "text": "Bleeding risk"
            },
            {
              "type": "list",
              "items": [
                "High-risk precautions (deep, noncompressible plexus block).",
                [
                  {
                    "link": {
                      "text": "Open anticoagulation table",
                      "articleId": "anticoagulation-table"
                    }
                  }
                ]
              ]
            },
            {
              "type": "heading",
              "text": "Hold"
            },
            {
              "type": "list",
              "items": [
                "Warfarin: hold 5 days; confirm normalized INR.",
                "IV heparin: hold 4-6 hours and confirm normal coagulation.",
                "Enoxaparin: hold at least 12 hours if prophylactic; at least 24 hours if therapeutic.",
                "DOACs: use deep-plexus drug-, dose-, and renal-function-specific intervals.",
                "Clopidogrel: hold 5-7 days; ticagrelor: 5 days; prasugrel: 7-10 days.",
                "Aspirin alone: no hold under ASRA regional guidance; confirm institutional policy and concurrent agents."
              ]
            },
            {
              "type": "heading",
              "text": "Caveat"
            },
            {
              "type": "list",
              "items": [
                "Deep-plexus guidance overrides generic IR holds. Confirm local platelet threshold, restart timing, and any heparin used for UFE.",
                [
                  {
                    "link": {
                      "text": "ASRA antithrombotic guidance",
                      "href": "https://rapm.bmj.com/content/early/2025/09/16/rapm-2024-105766"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR: within normal laboratory range.",
                "Platelets >50,000/µL."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "NPO (if moderate sedation).",
                "Vital signs per routine.",
                "PIV placement (not left arm).",
                "Glucose POC.",
                "CBC and INR if not already available for UFE; additional coagulation testing per anticoagulant plan."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "heading",
              "text": "Options"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " local anesthesia; moderate sedation as part of the UFE plan."
                ],
                [
                  {
                    "strong": "Alternative:"
                  },
                  " additional sedation in selected patients; maintain monitoring and responsiveness when feasible."
                ],
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication."
                  },
                  ""
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " L5/sacral promontory, iliac vessels, and bowel-free needle path."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " confirm results meet procedure-specific requirements when indicated; see the Labs tab."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm deep-plexus hold/restart plan, including any heparin used during UFE."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm anesthetic plan:"
                  },
                  " allergies, agent/dose, and total local anesthetic from all sites; lipid rescue available."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " include the block and its specific risks with the UFE discussion."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
            {
              "type": "heading",
              "text": "Procedure"
            },
            {
              "type": "list",
              "items": [
                "Image-guided superior hypogastric nerve block."
              ]
            },
            {
              "type": "heading",
              "text": "Risks"
            },
            {
              "type": "list",
              "items": [
                "Bleeding.",
                "Infection.",
                "Damage to nearby structures."
              ]
            },
            {
              "type": "heading",
              "text": "Procedure-specific risks"
            },
            {
              "type": "list",
              "items": [
                "Incomplete or failed pain relief.",
                "Local-anesthetic systemic toxicity, including seizure or arrhythmia.",
                "Hypotension, nerve injury, or retroperitoneal hematoma.",
                "Bowel, vascular, or disc injury."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Target plexus:"
                  },
                  " retroperitoneal, anterior to L5-S1 near the sacral promontory."
                ],
                [
                  {
                    "strong": "Pelvic pain pathway:"
                  },
                  " carries visceral pain fibers from the uterus and other pelvic organs."
                ],
                [
                  {
                    "strong": "Nearby vessels:"
                  },
                  " aortic bifurcation, iliac arteries, and iliac veins lie close to the target."
                ],
                [
                  {
                    "strong": "Needle window:"
                  },
                  " bowel and an enlarged uterus may obstruct an anterior approach; plan from patient-specific imaging."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Plan the window:"
                  },
                  " position supine and identify the target and safe path with fluoroscopy plus available cross-sectional imaging."
                ],
                [
                  {
                    "strong": "2. Prepare and anesthetize:"
                  },
                  " sterile prep and local anesthesia; account for the cumulative anesthetic dose."
                ],
                [
                  {
                    "strong": "3. Advance to the target:"
                  },
                  " guide the needle to the prevertebral space anterior to L5; confirm depth in orthogonal views or CT guidance."
                ],
                [
                  {
                    "strong": "4. Confirm spread:"
                  },
                  " aspirate and inject a small contrast test dose; require extravascular prevertebral spread before anesthetic."
                ],
                [
                  {
                    "strong": "5. Inject and reassess:"
                  },
                  " give local anesthetic incrementally per attending protocol, monitor for toxicity, then remove the needle and reassess pain/vitals."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Intravascular injection:"
                      },
                      " vascular contrast washout means reposition; negative aspiration alone is not enough."
                    ],
                    [
                      {
                        "strong": "Anesthetic toxicity:"
                      },
                      " published block example: bupivacaine 0.25%, 20 mL (50 mg); confirm attending dose and total anesthetic from all sites. Stop for toxicity symptoms and activate the LAST protocol."
                    ],
                    [
                      {
                        "strong": "Bowel/vessel injury:"
                      },
                      " do not proceed without a safe window; use CT/CBCT when anatomy is unclear."
                    ],
                    [
                      {
                        "strong": "Disc or neural entry:"
                      },
                      " confirm depth and contrast pattern; stop for unexpected pain or spread."
                    ],
                    [
                      {
                        "strong": "Incomplete block/hypotension:"
                      },
                      " reassess vitals and analgesia; do not repeat doses without reviewing the cumulative dose."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
