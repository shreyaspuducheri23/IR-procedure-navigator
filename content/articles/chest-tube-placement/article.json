          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Low bleeding risk, with case-specific features that may make it high risk."
                },
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    "Consider making this high risk for complexity of collection, difficult access to collection, or large-bore surgical-type tube.",
