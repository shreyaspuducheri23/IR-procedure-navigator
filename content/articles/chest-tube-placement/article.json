            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "No safe access route: consider image-guided or surgical alternatives.",
                    "Unmanageable bleeding risk (relative; do not delay lifesaving decompression).",
                    "Infected skin at the planned entry site: choose another site.",
                    "Hepatic hydrothorax: avoid routine chest drainage unless a compelling indication exists."
                  ]
                }
              ]
            }
          ]
