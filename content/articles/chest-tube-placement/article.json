              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Symptomatic pneumothorax.",
                "Large pneumothorax.",
                "Pleural effusion requiring continuous drainage.",
                "Empyema/complicated parapneumonic effusion.",
                "Hemothorax.",
                "Postoperative/posttraumatic pleural collection."
              ]
