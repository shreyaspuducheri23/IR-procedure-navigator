    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Celiac plexus:"
                  },
                  " surrounds the celiac origin near T12-L1, anterior to the diaphragmatic crura and aorta."
                ],
                [
                  {
                    "strong": "Celiac ganglia:"
                  },
                  " lie along the anterolateral aorta; position and symmetry vary."
                ],
                [
                  {
                    "strong": "Splanchnic nerves:"
                  },
                  " run behind the crura; retrocrural targeting is distinct from direct celiac plexus injection."
                ],
                [
                  {
                    "strong": "Nearby structures:"
                  },
                  " map the aorta, celiac/SMA origins, kidneys, pancreas, bowel, and pleura before choosing a path."
                ],
                [
                  {
                    "strong": "Tumor and prior surgery:"
                  },
                  " can distort the target and limit injectate spread; review cross-sectional imaging."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Plan the target and approach:"
                  },
                  " confirm block vs neurolysis and choose a safe CT-guided needle path."
                ],
                [
                  {
                    "strong": "Position and prepare:"
                  },
                  " establish monitoring/IV access, sterile prep, and local anesthesia."
                ],
                [
                  {
                    "strong": "Advance the needle:"
                  },
                  " use interval CT to reach the planned target while avoiding vessels and adjacent organs."
                ],
                [
                  {
                    "strong": "Confirm position and spread:"
                  },
                  " aspirate and inject contrast; exclude vascular or neuraxial spread before treatment."
                ],
                [
                  {
                    "strong": "Deliver the planned agent:"
                  },
                  " local anesthetic for block; neurolytic agent for neurolysis after appropriate test injection, per attending protocol."
                ],
                [
                  {
                    "strong": "Reassess and observe:"
                  },
                  " check pain response, blood pressure, and neurologic status before recovery/discharge."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Hypotension:"
                      },
                      " sympathetic blockade can lower BP; monitor and manage fluids according to clinical status."
                    ],
                    [
                      {
                        "strong": "Diarrhea and pain flare:"
                      },
                      " commonly transient; counsel and reassess persistent or severe symptoms."
                    ],
                    [
                      {
                        "strong": "Neurologic injury:"
                      },
                      " rare but serious; avoid spinal canal/foraminal spread and stop for new weakness or sensory change."
                    ],
                    [
                      {
                        "strong": "Intravascular injection:"
                      },
                      " negative aspiration alone is insufficient; confirm contrast spread before injecting."
                    ],
                    [
                      {
                        "strong": "Organ or pleural injury:"
                      },
                      " reassess the entire needle path; new dyspnea or severe pain warrants evaluation."
                    ],
                    [
                      {
                        "strong": "Incomplete relief:"
                      },
                      " poor spread or nonvisceral pain may limit benefit; do not compensate with blind additional injection."
                    ]
                  ]
                },
                {
