  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Neurolysis"
            },
            {
              "type": "list",
              "items": [
                "Refractory upper-abdominal visceral pain, commonly secondary to malignancy or nodal disease."
              ]
            },
            {
              "type": "heading",
              "text": "Block"
            },
            {
              "type": "list",
              "items": [
                "Chronic pancreatitis-associated pain.",
                "Diagnostic block before neurolysis."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "paragraph",
              "text": "Key contraindications and reasons to defer; relative risks require an individualized decision."
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Uncorrectable coagulopathy or no safe needle path.",
                    "Local infection or uncontrolled systemic infection.",
                    "Hemodynamic instability or significant hypotension.",
                    "Bowel obstruction; pain not mediated by the celiac plexus will not benefit."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: hold 5 days and confirm INR <= 1.8.",
                    "IV unfractionated heparin: hold 4-6 hours and check aPTT or anti-Xa level.",
                    "Enoxaparin: hold 1 dose if prophylactic; hold 2 doses or 24 hours if therapeutic.",
                    "DOAC timing is agent-, dose-, and renal-function-specific; use the anticoagulation table.",
                    "Clopidogrel and ticagrelor: hold 5 days; prasugrel: hold 7 days.",
                    "Aspirin: hold 3-5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50,000/µL."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "NPO (if moderate sedation).",
                "Vital signs per routine.",
                "PIV placement (not left arm).",
                "Glucose POC.",
                "Bedded Outpatient"
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " local anesthesia."
                ],
                [
                  {
                    "strong": "Alternative:"
                  },
                  " moderate sedation in selected patients."
                ],
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication:"
                  },
                  " block vs neurolysis; assess contraindications and confirm a compatible visceral pain pattern."
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " cross-sectional target anatomy, tumor burden, vessels, bowel, kidneys, and anticipated approach."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " CBC, INR, and other labs as indicated."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm the procedure-specific hold/continue plan; see the Anticoagulation tab."
                ],
                [
                  {
                    "strong": "Assess clinical status:"
                  },
                  " infection/sepsis, hemodynamic instability, bowel obstruction, and uncorrectable coagulopathy."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Patient is consented:"
                  },
                  " include hypotension, diarrhea, bleeding, infection, neurologic injury, and pneumothorax/organ injury depending on approach."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
