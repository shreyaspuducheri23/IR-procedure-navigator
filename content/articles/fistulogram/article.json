                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Diet, vitals, pain control, outpatient discharge, AVS, and suture device follow-up."
        },
        {
          "type": "heading",
          "text": "Follow up"
        },
        {
          "type": "list",
          "items": [
            "Remove suture device on POD1 if inpatient."
          ]
        },
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "Regular diet.",
            "Vital signs per unit routine.",
            "Tylenol 650 mg PRN."
          ]
        },
        {
          "type": "checklist",
          "title": "If outpatient procedure",
          "items": [
            "Discharge order with medication reconciliation.",
            "After visit summary: .IRAVSFISTULOGRAM."
          ]
        }
      ]
    }
  ]
