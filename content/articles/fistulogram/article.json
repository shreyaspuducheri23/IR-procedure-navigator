  "category": "vascular-access",
  "status": "complete",
  "bleedRisk": "low",
  "keywords": [],
  "summary": "Fistulogram guidance for dialysis access dysfunction, cannulation problems, prolonged bleeding, and abnormal access exam findings.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm anticoagulation hold language with local policy.",
    "Confirm INR and platelet thresholds with local policy.",
    "Confirm outpatient AVS and POD1 suture removal workflow."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Dialysis access dysfunction, cannulation problems, prolonged bleeding, or abnormal exam."
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Poor dialysis function: low flow, high venous pressures, incomplete dialysis.",
                "Cannulation problems: difficult access or failed fistula maturity.",
                "Prolonged bleeding after dialysis.",
                "Physical exam findings: swelling, absent thrill/pulse."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: no holding requirement.",
                    "Heparin: no holding requirement.",
                    "Lovenox: no holding requirement.",
                    "DOACs: no holding requirement.",
                    "Plavix: no holding requirement.",
                    "Aspirin: no holding requirement."
                  ]
                },
                {
                  "type": "heading",
                  "text": "Caveat"
                },
                {
                  "type": "list",
                  "items": [
                    "Consider holding only if significant intervention is anticipated—large-bore access, thrombectomy/thrombolysis—or the patient has additional bleeding risks."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 2-3.",
                "Platelets >20k."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Orders"
            },
            {
              "type": "list",
              "items": [
                "Patient is NPO if moderate sedation."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Confirm indication and review imaging.",
                "Labs are appropriate.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                "Confirm sedation plan - patient can lie flat."
              ]
            },
            {
              "type": "heading",
              "text": "Physical exam"
            },
            {
              "type": "paragraph",
              "text": "Evaluate fistula exam and access patency before the procedure."
            },
            {
              "type": "list",
              "items": [
                "Evaluate fistula for thrill/pulse.",
                "POC ultrasound to evaluate patency.",
                "Formal vascular ultrasound to evaluate flows."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "The circuit:"
                  },
                  " artery > anastomosis > fistula/graft > outflow veins > SVC."
                ],
                [
                  {
                    "strong": "Know the configuration:"
                  },
                  " radiocephalic, brachiocephalic, transposed brachiobasilic, or graft. Confirm flow direction; loop shape can mislead."
                ],
                [
                  {
                    "strong": "Stenosis hotspots:"
                  },
                  " radiocephalic: near the anastomosis; brachiocephalic: cephalic arch; graft: graft-vein junction."
                ],
                [
                  {
                    "strong": "Central veins:"
                  },
                  " axillary > subclavian > brachiocephalic > SVC. Collaterals may signal obstruction."
                ],
                [
                  {
                    "strong": "Before puncture:"
                  },
                  " locate aneurysms, thrombus, stents, and usable access segments."
                ],
                [
                  {
                    "strong": "Check the hand:"
                  },
                  " a patent access does not guarantee adequate distal perfusion."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Define the problem."
                  },
                  " Match dialysis symptoms with exam, ultrasound, and prior interventions."
                ],
                [
                  {
                    "strong": "2. Access with a plan."
                  },
                  " Use ultrasound; choose a site and direction that reach the suspected lesion."
                ],
                [
                  {
                    "strong": "3. Image the whole circuit."
                  },
                  " Include arterial inflow, anastomosis, access, and central outflow."
                ],
                [
                  {
                    "strong": "4. Find the cause."
                  },
                  " Stenosis, clot, poor maturation, or hand ischemia? Treat what explains the dysfunction."
                ],
                [
                  {
                    "strong": "5. Treat selectively."
                  },
                  " Angioplasty for culprit stenosis; declot plus lesion treatment for thrombosis. Escalate to stent-graft or surgery when appropriate."
                ],
                [
                  {
                    "strong": "6. Confirm the result."
                  },
                  " Check completion imaging, thrill, and hand perfusion; exclude residual obstruction, leak, or clot."
                ],
                [
                  {
                    "strong": "7. Close and hand off."
                  },
                  " Preserve flow during hemostasis. Tell dialysis staff about usability, puncture restrictions, and suture removal."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Bleeding:"
                      },
                      " avoid compromised skin and pseudoaneurysms; stop bleeding without eliminating the thrill."
                    ],
                    [
                      {
                        "strong": "Rupture:"
                      },
                      " avoid oversized balloons and forceful wires. New leak or expanding swelling: assess promptly; preserve wire access."
                    ],
                    [
                      {
                        "strong": "Thrombosis:"
                      },
                      " avoid prolonged occlusion or excessive compression. Lost thrill needs immediate reassessment."
                    ],
                    [
                      {
                        "strong": "Declot embolization:"
                      },
                      " never force-inject clot. New cold/painful hand, neurologic deficit, hypoxia, or chest pain needs urgent evaluation."
                    ],
                    [
                      {
                        "strong": "Wrong target:"
                      },
                      " check inflow and central outflow. Treat the clinical problem, not every narrowing."
                    ],
                    [
                      {
                        "strong": "Future access:"
                      },
                      " do not let a stent-graft compromise key veins, cannulation zones, or surgical options."
                    ],
                    [
                      {
                        "strong": "Infection:"
                      },
                      " avoid infected skin and routine declotting of infected access; coordinate an infection/access plan."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
