  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Dialysis access dysfunction, cannulation problems, prolonged bleeding, or abnormal exam."
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Poor dialysis function: low flow, high venous pressures, incomplete dialysis.",
                "Cannulation problems: difficult access or failed fistula maturity.",
                "Prolonged bleeding after dialysis.",
                "Physical exam findings: swelling, absent thrill/pulse."
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 2-3.",
                "Platelets >20k."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: no holding requirement.",
                    "Heparin: no holding requirement.",
                    "Lovenox: no holding requirement.",
                    "DOACs: no holding requirement.",
                    "Plavix: no holding requirement.",
                    "Aspirin: no holding requirement."
                  ]
                },
                {
                  "type": "heading",
                  "text": "Caveat"
                },
                {
                  "type": "list",
                  "items": [
                    "Consider holding only if significant intervention is anticipated—large-bore access, thrombectomy/thrombolysis—or the patient has additional bleeding risks."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "physical-exam",
          "title": "Physical exam",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Evaluate fistula exam and access patency before the procedure."
            },
            {
              "type": "list",
              "items": [
                "Evaluate fistula for thrill/pulse.",
                "POC ultrasound to evaluate patency.",
                "Formal vascular ultrasound to evaluate flows."
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm indication, imaging, labs, NPO status if sedated, and moderate sedation tolerance."
            },
            {
              "type": "list",
              "items": [
                "Confirm indication and review imaging.",
                "Labs are appropriate.",
                "Patient is NPO if moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
