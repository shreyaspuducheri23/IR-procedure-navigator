    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Retrieval hook:"
                  },
                  " identify its orientation, tilt, and possible embedding in the caval wall."
                ],
                [
                  {
                    "strong": "Filter and cava:"
                  },
                  " assess trapped thrombus, caval patency, and suspected strut penetration or fracture."
                ],
                [
                  {
                    "strong": "Retrieval route:"
                  },
                  " choose access compatible with the filter design; many standard filters are retrieved from the jugular vein."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Confirm removal is appropriate"
                  },
                  " and review filter type, dwell time, and available imaging for complexity."
                ],
                [
                  {
                    "strong": "2. Obtain access and perform cavography"
                  },
                  " to assess thrombus and filter position before retrieval."
                ],
                [
                  {
                    "strong": "3. Capture the retrieval hook"
                  },
                  " and collapse the filter into the sheath under fluoroscopy, following device instructions."
                ],
                [
                  {
                    "strong": "4. Remove and inspect"
                  },
                  " for an intact filter; check completion cavography for injury, then obtain access-site hemostasis."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Significant trapped thrombus:"
                      },
                      " pause retrieval and reassess embolic risk and the anticoagulation plan."
                    ],
                    [
                      {
                        "strong": "Embedded hook or resistance:"
                      },
                      " avoid forceful traction; escalate to a planned advanced retrieval strategy."
                    ],
                    [
                      {
                        "strong": "Caval injury:"
                      },
                      " new pain, extravasation, or instability requires immediate assessment and hemorrhage control."
                    ],
                    [
                      {
                        "strong": "Missing strut:"
                      },
                      " compare the retrieved device with its expected design and localize any retained or embolized fragment."
                    ]
                  ]
                },
