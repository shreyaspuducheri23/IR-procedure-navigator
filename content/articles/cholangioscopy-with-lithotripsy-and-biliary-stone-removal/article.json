    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Biliary tree:"
                  },
                  " right and left hepatic ducts join the common hepatic duct; the cystic duct joins to form the common bile duct."
                ],
                [
                  {
                    "strong": "Outflow:"
                  },
                  " identify the ampulla or biliary-enteric anastomosis, strictures, and isolated ducts."
                ],
                [
                  {
                    "strong": "Access:"
                  },
                  " review the existing biliary drain course and its relationship to the target stones."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "callout",
              "variant": "note",
              "title": "Quick steps",
              "collapsible": true,
              "defaultOpen": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic steps"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Define the target:"
                      },
                      " perform cholangiography to assess stones, strictures, and outflow."
                    ],
                    [
                      {
                        "strong": "2. Establish access:"
                      },
                      " maintain wire access and place a compatible sheath through the planned tract."
                    ],
                    [
                      {
                        "strong": "3. Inspect:"
                      },
                      " advance the cholangioscope under imaging and direct vision; irrigate enough to maintain visibility."
                    ],
                    [
                      {
                        "strong": "4. Fragment stones:"
                      },
                      " use lithotripsy under direct visualization, keeping the probe directed at the stone and away from the duct wall."
                    ],
                    [
                      {
                        "strong": "5. Clear fragments:"
                      },
                      " use a basket or balloon as appropriate; avoid forcing stones through a narrowed outlet."
                    ],
                    [
                      {
                        "strong": "6. Confirm and drain:"
                      },
                      " reassess clearance and outflow with cholangioscopy/cholangiography; replace the drain as indicated and secure it."
                    ]
                  ]
                }
              ]
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "Detailed steps",
              "collapsible": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Content pending."
                }
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Access loss:"
                      },
                      " confirm tract suitability before dilation and maintain wire access during exchanges."
                    ],
                    [
                      {
                        "strong": "Sepsis:"
                      },
                      " confirm antibiotic coverage; avoid excessive irrigation pressure and maintain drainage."
                    ],
                    [
                      {
                        "strong": "Duct injury:"
                      },
                      " do not activate lithotripsy without a clear view of the stone; follow device instructions."
                    ],
                    [
                      {
                        "strong": "Residual stones:"
                      },
                      " check upstream ducts and outflow; stage treatment if clearance is incomplete."
                    ]
                  ]
                },
