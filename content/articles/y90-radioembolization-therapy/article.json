        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "checklist",
              "title": "Core checklist",
              "items": [
                [
                  {
                    "strong": "Confirm indication."
                  },
                  ""
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " review anatomy from the Y90 mapping study."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " confirm results meet procedure-specific requirements when indicated; see the Labs tab."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm the procedure-specific hold/continue plan; see the Anticoagulation tab."
                ],
                [
                  {
                    "strong": "Confirm chemotherapy interval:"
                  },
                  " verify no chemotherapy for at least 2 weeks before treatment; confirm any longer agent-specific hold with oncology."
                ],
                [
                  {
                    "strong": "CT cone beam available"
                  },
                  "."
                ],
                [
                  {
                    "strong": "Nuclear medicine aware and scheduled"
                  },
                  "."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " discuss the procedure and patient-specific risks; identify a surrogate if needed."
                ]
              ]
            },
            {
              "type": "checklist",
              "title": "Lung shunt fraction from Tc-99m mapping scan",
              "items": [
                [
                  {
                    "strong": "< 10% - acceptable."
                  },
                  ""
                ],
                [
                  {
                    "strong": "10-20% - elevated"
                  },
                  "; calculate predicted lung dose and potentially reduce Y90 activity."
                ],
                [
                  {
                    "strong": "> 20% - contraindication for SIR-Sphere resin microspheres."
                  },
                  ""
                ]
              ]
            },
            {
              "type": "checklist",
              "title": "TheraSphere glass microspheres",
              "items": [
                [
                  {
                    "strong": "No percentage cutoff for TheraSphere glass microspheres"
                  },
                  "; lung dose is the metric."
                ],
                [
                  {
                    "strong": "< 30 Gy per treatment."
                  },
                  ""
                ],
                [
                  {
                    "strong": "< 50 Gy cumulative."
                  },
                  ""
                ]
              ]
            }
