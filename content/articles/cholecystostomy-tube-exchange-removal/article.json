{
  "schemaVersion": 1,
  "id": "cholecystostomy-tube-exchange-removal",
  "title": "Cholecystostomy Tube Exchange/Removal",
  "category": "drain-tube",
  "status": "complete",
  "bleedRisk": "low",
  "keywords": [],
  "summary": "Existing tube maintenance and assessment for safe removal; routine mature-tract exchange is distinct from new placement.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm high bleeding risk classification with local policy.",
    "Confirm anticoagulation hold and restart times with the final table.",
    "Confirm flush order wording.",
    "Confirm 2-3 month drain check scheduling workflow."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Exchange for catheter obstruction, leakage, malfunction, or scheduled maintenance when drainage is still required."
              ]
            },
            {
              "type": "heading",
              "text": "Removal after acalculous cholecystitis"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Clinical improvement:"
                  },
                  " no recurrent pain, fever, or ongoing cholecystitis; no ongoing need for drainage."
                ],
                [
                  {
                    "strong": "Mature tract:"
                  },
                  " confirm tract maturity and no contrast leak at the drain check."
                ],
                [
                  {
                    "strong": "Passed tube check/capping trial:"
                  },
                  " patent cystic duct and common bile duct with contrast reaching the duodenum; tolerate capping if used by the treating team."
                ]
              ]
            },
            {
              "type": "heading",
              "text": "References"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "link": {
                      "text": "International consensus: post-cholecystostomy management and removal",
                      "href": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12165509/"
                    }
                  }
                ]
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Do not remove with unresolved infection, obstruction, bile leak, or an immature tract.",
                    "Lost access or a displaced tube may require new placement rather than routine exchange."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: no holding requirement.",
                    "Heparin: no holding requirement.",
                    "Lovenox: no holding requirement.",
                    "DOACs: no holding requirement.",
                    "Plavix: no holding requirement.",
                    "Aspirin: no holding requirement."
                  ]
                },
                {
                  "type": "heading",
                  "text": "Caveat"
                },
                {
                  "type": "list",
                  "items": [
                    "Reassess bleeding risk if new access or substantial tract manipulation is needed."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "No routine pre-procedure labs required for uncomplicated mature-tract exchange/removal; obtain only if clinically indicated."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "No routine pre-procedure orders required for uncomplicated exchange/removal. Individualize if sedation or infection management is needed."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " local anesthesia as needed; systemic sedation is generally not required."
                ],
                [
                  {
                    "strong": "Alternative:"
                  },
                  " moderate sedation in selected patients."
                ],
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication:"
                  },
                  " exchange versus removal; establish whether drainage is still needed."
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " prior access route, drain position, and cystic duct/CBD patency on prior tube studies; verify tract age from the procedure record."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " none routinely required; review if clinically indicated."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " no routine holds for uncomplicated mature-tract exchange/removal."
                ],
                [
                  {
                    "strong": "Confirm removal readiness:"
                  },
                  " clinical recovery, tract maturity, duct patency, and capping tolerance when applicable."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " exchange versus removal and patient-specific risks."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
            {
              "type": "heading",
              "text": "Procedure"
            },
            {
              "type": "list",
              "items": [
                "Cholecystostomy Tube Placement/Exchange"
              ]
            },
            {
              "type": "heading",
              "text": "Common risks"
            },
            {
              "type": "list",
              "items": [
                "Infection.",
                "Bleeding.",
                "Injury to nearby structures."
              ]
            },
            {
              "type": "heading",
              "text": "Procedure-specific risks"
            },
            {
              "type": "list",
              "items": [
                "Bile leak or biloma."
              ]
            },
            {
              "type": "heading",
              "text": "Consent discussion"
            },
            {
              "type": "list",
              "items": [
                "Discuss the expected benefit, alternatives, and patient-specific risks. This risk summary supports the discussion and institutional consent form; it is not an exhaustive consent document."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Existing tract:"
                  },
                  " preserve the established route into the gallbladder; confirm maturity before removal."
                ],
                [
                  {
                    "strong": "Drainage pathway:"
                  },
                  " cystic duct to common bile duct to duodenum; patency supports removal."
                ],
                [
                  {
                    "strong": "Catheter position:"
                  },
                  " the loop and side holes should remain within the gallbladder."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Assess the tube:"
                  },
                  " inspect the site and gently inject contrast to confirm position, duct patency, and any leak."
                ],
                [
                  {
                    "strong": "Exchange if needed:"
                  },
                  " maintain wire access, unlock/remove the old tube, and place the replacement with all side holes intraluminal."
                ],
                [
                  {
                    "strong": "Remove only when ready:"
                  },
                  " confirm removal criteria, release the locking mechanism, and gently withdraw the tube."
                ],
                [
                  {
                    "strong": "Complete care:"
                  },
                  " confirm drainage and secure an exchanged tube; dress the site after removal and provide return precautions."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Premature removal:"
                      },
                      " an immature tract or persistent obstruction risks bile leak and recurrent cholecystitis."
                    ],
                    [
                      {
                        "strong": "Loss of access:"
                      },
                      " maintain wire purchase during exchange; do not blindly replace a displaced tube."
                    ],
                    [
                      {
                        "strong": "Forceful injection or traction:"
                      },
                      " avoid overdistention; release the locking mechanism before removal."
                    ],
                    [
                      {
                        "strong": "Clinical deterioration:"
                      },
                      " evaluate new pain, fever, bleeding, or persistent bile leakage promptly."
                    ]
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "Vital signs per routine.",
            "Monitor the access site for bleeding or bile leakage."
          ]
        },
        {
          "type": "checklist",
          "title": "Access care",
          "items": [
            "After exchange: secure the tube, maintain prescribed drainage, and continue the established flush plan.",
            "After removal: apply a dressing and provide wound-care instructions."
          ]
        },
        {
          "type": "checklist",
          "title": "Discharge",
          "items": [
            "Discharge when clinically appropriate with medication reconciliation.",
            "After visit summary: .IRCHOLETUBEBILIARYDRAIN1.",
            "Return for fever, increasing abdominal pain, bleeding, or persistent bile leakage."
          ]
        },
        {
          "type": "checklist",
          "title": "Follow up",
          "items": [
            "If exchanged or not removed: drain check/exchange in 2-3 months.",
            "Calculous cholecystitis: surgery manages and tube comes out with cholecystectomy."
          ]
        }
      ]
    }
  ]
}
