      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Symptomatic abscess/fluid collection.",
                "Source control for unknown infection.",
                "Persistent clinical symptoms despite antibiotics.",
                "Collection causing obstruction or mass effect.",
                "Bridge to surgery."
              ]
            }
          ]
        },
        {
          "id": "labs-and-orders",
          "title": "Labs and Orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Labs"
            },
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50k."
              ]
            },
            {
              "type": "heading",
              "text": "Orders"
            },
            {
              "type": "list",
              "items": [
                "Antibiotics with gram negative coverage, if not already ordered."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding risk; hold anticoagulants/antiplatelets per policy."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: 5 days.",
                    "Heparin: 6-8 hours.",
                    "Lovenox: 24 hours; hold 1 dose prior if prophylactic.",
                    "DOACs: 48 hours.",
                    "Plavix: 5 days.",
                    "Aspirin: 5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm indication, formed collection, labs, anticoagulation holds, imaging window, NPO status, and sedation tolerance."
            },
            {
              "type": "list",
              "items": [
                "Confirm indication and imaging demonstrates formed collection.",
                "Labs are appropriate.",
                "Anticoagulation appropriately held.",
                "Appropriate imaging window.",
                "Patient is NPO.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
