{
  "schemaVersion": 1,
  "id": "drainage-catheter-placement-exchange",
  "title": "Drainage Catheter Placement/Exchange",
  "category": "drain-tube",
  "status": "complete",
  "bleedRisk": "high",
  "keywords": [],
  "summary": "Drainage catheter placement or exchange guidance for abscess/fluid collection source control, with high-risk anticoagulation holds and drain follow-up.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm high bleeding risk classification with local policy.",
    "Confirm anticoagulation hold times with the final table.",
    "Confirm standard drain flush order wording.",
    "Confirm CT and drain check scheduling workflow."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Symptomatic abscess/fluid collection.",
                "Source control for unknown infection.",
                "Persistent clinical symptoms despite antibiotics.",
                "Collection causing obstruction or mass effect.",
                "Bridge to surgery."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding risk; hold anticoagulants/antiplatelets per policy."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: hold 5 days and confirm INR <= 1.8.",
                    "IV unfractionated heparin: hold 4-6 hours and check aPTT or anti-Xa.",
                    "Enoxaparin: hold 1 dose if prophylactic; hold 2 doses or 24 hours if therapeutic.",
                    "DOACs: use agent- and CrCl-specific timing in the anticoagulation table.",
                    "Clopidogrel: hold 5 days.",
                    "Aspirin: hold 3-5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50k."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Orders"
            },
            {
              "type": "list",
              "items": [
                "Antibiotics with gram negative coverage, if not already ordered.",
                "Patient is NPO."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Confirm indication and imaging demonstrates formed collection.",
                "Labs are appropriate.",
                "Anticoagulation appropriately held.",
                "Appropriate imaging window.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Collection:"
                  },
                  " define size, depth, loculations, and a drainable fluid component."
                ],
                [
                  {
                    "strong": "Access route:"
                  },
                  " map bowel, vessels, solid organs, and pleura before choosing a tract."
                ],
                [
                  {
                    "strong": "Dependent pocket:"
                  },
                  " position the loop and side holes within the cavity for effective drainage."
                ],
                [
                  {
                    "strong": "Existing tract:"
                  },
                  " preserve it during exchange; a recent tract may not tolerate loss of wire access."
                ],
                [
                  {
                    "strong": "Fistulous connections:"
                  },
                  " bowel, biliary, or urinary communication may explain persistent output."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Review the target"
                  },
                  " and choose catheter size and access using US or CT."
                ],
                [
                  {
                    "strong": "2. Prep and anesthetize"
                  },
                  " the planned tract; confirm antibiotic coverage for an infected collection."
                ],
                [
                  {
                    "strong": "3. Establish access"
                  },
                  " for placement, puncture and aspirate the collection; for exchange, gently inject the existing catheter to define the cavity."
                ],
                [
                  {
                    "strong": "4. Secure a wire in the cavity"
                  },
                  " before tract dilation or removal of the old catheter; release its locking mechanism first."
                ],
                [
                  {
                    "strong": "5. Place the new catheter"
                  },
                  " with the loop and all drainage side holes inside the collection; confirm by imaging."
                ],
                [
                  {
                    "strong": "6. Aspirate, secure, and connect"
                  },
                  " to drainage; send fresh aspirate for requested studies and specify flushing and follow-up."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Unsafe window:"
                      },
                      " avoid unintended bowel, vessel, or pleural traversal; reconsider the route if none is safe."
                    ],
                    [
                      {
                        "strong": "Sepsis:"
                      },
                      " minimize manipulation and forceful injection; escalating rigors or hypotension need prompt treatment."
                    ],
                    [
                      {
                        "strong": "Lost access:"
                      },
                      " keep a stable wire in the cavity before removing the old drain; do not blindly probe a lost tract."
                    ],
                    [
                      {
                        "strong": "Poor output:"
                      },
                      " check kinking, blockage, side-hole position, and undrained loculations before upsizing."
                    ],
                    [
                      {
                        "strong": "New bloody output:"
                      },
                      " suspect vascular injury; stop manipulation and assess before removing the catheter."
                    ],
                    [
                      {
                        "strong": "Persistent enteric or high output:"
                      },
                      " consider a fistula; clarify the source before catheter removal."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
