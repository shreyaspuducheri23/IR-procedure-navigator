    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "heading",
              "text": "G-tube exchange"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Existing tract:"
                  },
                  " connects skin to stomach; maturity determines whether routine exchange is safe."
                ],
                [
                  {
                    "strong": "Retention device:"
                  },
                  " the balloon or bumper belongs inside the stomach, not the tract."
                ],
                [
                  {
                    "strong": "Tube fit:"
                  },
                  " match device type, diameter, and stoma length for low-profile tubes."
                ],
                [
                  {
                    "strong": "Pylorus:"
                  },
                  " distal tube migration can obstruct gastric emptying."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "G-tube exchange"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Confirm the setup."
                  },
                  " Check tract maturity, tube type, and reason for exchange."
                ],
                [
                  {
                    "strong": "2. Confirm gastric access."
                  },
                  " Inject contrast gently; a retracted tube may no longer be intragastric."
                ],
                [
                  {
                    "strong": "3. Preserve the tract."
                  },
                  " Secure wire access in the stomach before removal when feasible."
                ],
                [
                  {
                    "strong": "4. Exchange without force."
                  },
                  " Deflate the balloon or release retention per device instructions; advance the replacement."
                ],
                [
                  {
                    "strong": "5. Seat the device."
                  },
                  " Confirm intragastric retention; fill the balloon per manufacturer instructions without excessive tension."
                ],
                [
                  {
                    "strong": "6. Verify before use."
                  },
                  " Confirm gastric contrast filling without leak; document fit, external length, and clearance."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "heading",
                  "text": "G-tube exchange"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Immature or uncertain tract:"
                      },
                      " no blind replacement; early dislodgement needs image-guided or endoscopic planning."
                    ],
                    [
                      {
                        "strong": "False passage:"
                      },
                      " stop for pain, resistance, or extravasation. Do not use until position is confirmed."
                    ],
                    [
                      {
                        "strong": "Lost access:"
                      },
                      " the tract can narrow quickly; arrange prompt assessment, not forceful re-entry."
                    ],
                    [
                      {
                        "strong": "Buried bumper:"
                      },
                      " pain or an immobile tube needs evaluation, not forceful traction."
                    ],
                    [
                      {
                        "strong": "Poor fit or leakage:"
                      },
                      " avoid tight bolsters and routine upsizing; check position, retention, and skin first."
                    ],
                    [
                      {
                        "strong": "Peritonitis or bleeding:"
                      },
                      " worsening pain, guarding, fever, instability, or significant bleeding needs urgent evaluation."
                    ]
                  ]
                },
                {
