  "summary": "Foreign body removal guidance for retained or embolized intravascular device fragments, with emphasis on location, what the consulting team has already attempted, access planning, and retrieval tools.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm low bleeding risk classification with local policy.",
    "Confirm anticoagulation language with the final table.",
    "Confirm standard retrieval tools by access route and object type.",
    "Confirm when cardiac anesthesia, surgery, or advanced support should be involved."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Initial evaluation"
            },
            {
              "type": "list",
              "items": [
                "Evaluate for location and what consulting team has done on their own."
              ]
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Retained or embolized intravascular foreign body.",
                "Fractured catheter, guidewire, port fragment, filter fragment, or other device component.",
                "Particularly important if intracardiac, in the pulmonary arteries, symptomatic, infected, thrombosed, causing arrhythmia, or at risk of migration.",
                "Usually retrieve when technically feasible, even if incidentally discovered."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ],
                    "No requirement to hold anticoagulation."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 2-3.",
                "Platelets >20k."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Procedure-specific pre-procedure orders have not yet been documented in this guide."
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Local, mostly.",
                "Moderate sedation in some cases.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Confirm indication.",
                "Review imaging with access.",
                "Labs are appropriate.",
                "Confirm access approach.",
                "If venous, have snare/retrieval tools available.",
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Object location:"
                  },
                  " define its full length, orientation, and whether a free end is available."
                ],
                [
                  {
                    "strong": "Retrieval path:"
                  },
                  " identify vessel caliber, bends, and a sheath route that can accommodate the captured object."
                ],
                [
                  {
                    "strong": "Adjacent structures:"
                  },
                  " assess contact with vessel walls, cardiac valves, or other implanted devices before traction."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Intravascular retrieval"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Localize and plan"
                  },
                  " using imaging; select access, retrieval tool, and a sheath large enough for the object."
                ],
                [
                  {
                    "strong": "2. Obtain access and approach"
                  },
                  " under imaging, minimizing contact that could displace the object."
                ],
                [
                  {
                    "strong": "3. Capture a free end"
                  },
                  " with a snare when feasible; use an alternative planned technique if no end is accessible."
                ],
                [
                  {
                    "strong": "4. Align and withdraw"
                  },
                  " the object into the sheath under fluoroscopy; stop if resistance or unsafe deformation develops."
                ],
                [
                  {
                    "strong": "5. Confirm complete removal"
                  },
                  " by inspecting the object and completion imaging; assess injury and obtain hemostasis."
                ]
              ]
            },
            {
              "type": "heading",
              "text": "Other locations"
            },
            {
              "type": "list",
              "items": [
                "Biliary, urinary, and soft-tissue foreign bodies require a location-specific access and retrieval plan."
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Further migration:"
                      },
                      " secure capture before withdrawal and avoid pushing the object downstream."
                    ],
                    [
                      {
                        "strong": "Vessel or valve injury:"
                      },
                      " do not pull an embedded or entangled object against resistance; reassess with experienced or surgical support."
                    ],
                    [
                      {
                        "strong": "Arrhythmia:"
                      },
                      " monitor during intracardiac manipulation and pause if sustained ectopy develops."
                    ],
                    [
                      {
                        "strong": "Incomplete retrieval:"
                      },
                      " check for fracture or missing fragments; localize any residual pieces before concluding."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
