  "summary": "Foreign body removal guidance for retained or embolized intravascular device fragments, with emphasis on location, what the consulting team has already attempted, access planning, and retrieval tools.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm low bleeding risk classification with local policy.",
    "Confirm anticoagulation language with the final table.",
    "Confirm standard retrieval tools by access route and object type.",
    "Confirm when cardiac anesthesia, surgery, or advanced support should be involved."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Initial evaluation"
            },
            {
              "type": "list",
              "items": [
                "Evaluate for location and what consulting team has done on their own."
              ]
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Retained or embolized intravascular foreign body.",
                "Fractured catheter, guidewire, port fragment, filter fragment, or other device component.",
                "Particularly important if intracardiac, in the pulmonary arteries, symptomatic, infected, thrombosed, causing arrhythmia, or at risk of migration.",
                "Usually retrieve when technically feasible, even if incidentally discovered."
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 2-3.",
                "Platelets >20k."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ],
                    "No requirement to hold anticoagulation."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Local, mostly.",
                "Moderate sedation in some cases.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Confirm indication.",
                "Review imaging with access.",
                "Labs are appropriate.",
                "Confirm access approach.",
                "If venous, have snare/retrieval tools available."
              ]
            }
          ]
        }
      ]
    },
