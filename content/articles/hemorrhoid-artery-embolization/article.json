    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "defaultOpen": true,
          "blocks": [
            {
              "type": "image",
              "src": "images/rectal-arterial-supply.png",
              "alt": "Anterior pelvic anatomy illustration labeling the inferior mesenteric, superior rectal, middle rectal, internal pudendal, and inferior rectal arteries.",
              "caption": "Arterial supply to the rectum. Original AI-generated educational illustration; confirm patient-specific anatomy and variants on procedural imaging."
            },
            {
              "type": "image",
              "src": "images/inferior-mesenteric-superior-rectal-schematic.png",
              "alt": "Simplified angiographic-style illustration labeling the inferior mesenteric artery, superior rectal artery, and right and left terminal branches.",
              "caption": "Simplified IMA and superior rectal artery branching pattern. AI-generated teaching illustration, not a patient angiogram; it omits normal variation and fine angiographic detail."
            },
            {
              "type": "image",
              "src": "images/internal-iliac-rectal-supply-schematic.png",
              "alt": "Simplified angiographic-style illustration labeling internal iliac contributions to the middle and inferior rectal arteries.",
              "caption": "Simplified internal iliac contribution to rectal arterial supply. AI-generated teaching illustration, not a patient angiogram; it omits normal variation and fine angiographic detail."
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "IMA:"
                  },
                  " commonly arises from the anterior aorta at approximately L3."
                ],
                [
                  {
                    "strong": "Superior rectal artery (SRA):"
                  },
                  " terminal branch of the IMA and primary supply to internal hemorrhoids."
                ],
                [
                  {
                    "strong": "SRA terminal branches:"
                  },
                  " divide into right and left branches supplying the hemorrhoidal plexus."
                ],
                [
                  {
                    "strong": "Middle rectal arteries:"
                  },
                  " variable branches of the internal iliac system that may provide important collateral supply."
                ],
                [
                  {
                    "strong": "Inferior rectal arteries:"
                  },
                  " arise from the internal pudendal arteries and supply the distal anal canal."
                ],
                [
                  {
                    "strong": "Rectal arterial anastomoses:"
                  },
                  " provide extensive collateral perfusion between superior, middle, and inferior rectal territories."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Procedure-specific access, device, imaging, and completion steps."
            },
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Obtain arterial access"
                  },
                  " and select the IMA."
                ],
                [
                  {
                    "strong": "2. Perform IMA angiography"
                  },
                  " to define SRA anatomy and target branches."
                ],
                [
                  {
                    "strong": "3. Microcatheterize the SRA"
                  },
                  " and advance into the distal hemorrhoidal branches."
                ],
                [
                  {
                    "strong": "4. Confirm target supply"
                  },
                  " with selective angiography."
                ],
                [
                  {
                    "strong": "5. Embolize the target branches"
                  },
                  " to near-stasis using the chosen embolic."
                ]
              ]
            },
            {
              "type": "heading",
              "text": "Step 5: embolic selection"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Elective symptomatic hemorrhoids:"
                  },
                  " most commonly microcoils, with particles used by some operators."
                ],
                [
                  {
                    "strong": "Emergent hemorrhoidal bleeding:"
                  },
                  " commonly coils for focal bleeding; particles or Gelfoam may be used for more diffuse bleeding."
                ]
              ]
            },
            {
              "type": "heading",
              "text": "Completion"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "6. Repeat angiography"
                  },
                  " to assess residual hemorrhoidal supply."
                ],
                [
                  {
                    "strong": "7. Evaluate or treat collateral supply"
                  },
                  " if significant persistent filling remains."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Missed collateral supply:"
                      },
                      " persistent filling may arise from middle or inferior rectal arteries; reassess pelvic collaterals."
                    ],
                    [
                      {
                        "strong": "Nontarget embolization:"
                      },
                      " confirm distal catheter position and exclude unintended branches before embolizing."
                    ],
                    [
                      {
                        "strong": "Vasospasm:"
                      },
                      " can obscure true supply; pause, reposition, or use a vasodilator as appropriate before assuming treatment is complete."
                    ],
                    [
                      {
                        "strong": "Incomplete bilateral treatment:"
                      },
                      " residual contralateral SRA supply can lead to persistent symptoms or bleeding."
                    ],
                    [
                      {
                        "strong": "Catheter instability or reflux:"
                      },
                      " embolize slowly and maintain stable distal position to avoid proximal or nontarget delivery."
                    ],
                    [
                      {
                        "strong": "Rectal ischemia:"
                      },
                      " uncommon because of rich collaterals, but avoid overly aggressive embolization of multiple rectal arterial territories."
                    ]
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
