            "Activity per JH-HLM mobility goal."
          ]
        },
        {
          "type": "checklist",
          "title": "If outpatient procedure",
          "items": [
            "Discharge order with medication reconciliation.",
            "After visit summary: .IRAVSHEMORRHOID."
          ]
        },
        {
          "type": "heading",
          "text": "Follow up"
        },
        {
          "type": "list",
          "items": [
            "1 month clinic follow up."
          ]
        }
      ]
    }
  ]
