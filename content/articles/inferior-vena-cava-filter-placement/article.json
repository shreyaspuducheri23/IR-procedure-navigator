    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Infrarenal IVC:"
                  },
                  " the usual landing zone lies below the lowest renal vein and above the iliac confluence."
                ],
                [
                  {
                    "strong": "Renal veins:"
                  },
                  " identify their actual entry sites, including accessory veins; do not rely on vertebral level alone."
                ],
                [
                  {
                    "strong": "Caval diameter:"
                  },
                  " measure at the planned landing zone and compare with the selected device's limits."
                ],
                [
                  {
                    "strong": "Variants:"
                  },
                  " duplicated or left-sided IVC can change the protection strategy and landing zone."
                ],
                [
                  {
                    "strong": "Access veins:"
                  },
                  " jugular or femoral access must provide a patent route; check for thrombus along the path."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Confirm indication and device"
                  },
                  " including access-compatible delivery system and a retrieval plan when appropriate."
                ],
                [
                  {
                    "strong": "2. Obtain venous access"
                  },
                  " under ultrasound and advance the catheter into the IVC."
                ],
                [
                  {
                    "strong": "3. Perform cavography"
                  },
                  " to define renal veins, iliac confluence, diameter, variants, and thrombus."
                ],
                [
                  {
                    "strong": "4. Position the delivery sheath"
                  },
                  " at the planned landing zone; confirm orientation and device-specific deployment landmarks."
                ],
                [
                  {
                    "strong": "5. Deploy under fluoroscopy"
                  },
                  " following the device instructions while maintaining stable, centered positioning."
                ],
                [
                  {
                    "strong": "6. Confirm and document"
                  },
                  " filter level, expansion, and tilt; remove the sheath, obtain hemostasis, and arrange retrieval follow-up."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Wrong landing zone:"
                      },
                      " identify the lowest renal vein before release; suprarenal placement requires a specific plan."
                    ],
                    [
                      {
                        "strong": "Missed duplicated IVC:"
                      },
                      " a second channel may bypass the filter; review cross-sectional imaging and cavography."
                    ],
                    [
                      {
                        "strong": "Caval or access thrombus:"
                      },
                      " avoid deploying into clot or advancing through a thrombosed route; reassess the approach."
                    ],
                    [
                      {
                        "strong": "Device mismatch:"
                      },
                      " verify caval diameter, access route, and filter orientation before loading or release."
                    ],
                    [
                      {
                        "strong": "Tilt or maldeployment:"
                      },
                      " stabilize the sheath and confirm alignment before release; do not force a deployed filter."
                    ],
                    [
                      {
                        "strong": "Forgotten retrieval:"
                      },
                      " assign follow-up ownership; prolonged dwell can lead to thrombosis, penetration, fracture, or difficult removal."
                    ]
                  ]
                },
                {
