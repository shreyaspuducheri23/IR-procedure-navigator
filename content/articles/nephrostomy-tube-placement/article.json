  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Percutaneous nephrostomy tube placement for collecting system decompression."
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Pyelonephritis with unstable vitals.",
                "Pyonephrosis.",
                "Renal decompression for obstruction with AKI.",
                "Failed, contraindicated, or unavailable retrograde ureteral stent.",
                "Urinary diversion when nephrostomy drainage is the intended endpoint."
              ]
            },
            {
              "type": "heading",
              "text": "Clarify before booking"
            },
            {
              "type": "list",
              "items": [
                "Side and level of obstruction.",
                "Whether nephrostomy tube drainage is the intended endpoint.",
                "Evidence of infection, sepsis, pyonephrosis, or obstructive AKI that changes urgency.",
                "Current ureteral stents, urinary diversion anatomy, and relevant prior urologic surgery."
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50k."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding risk; hold anticoagulants/antiplatelets per policy."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: 5 days.",
                    "Heparin: 6-8 hours.",
                    "Lovenox: 24 hours; hold 1 dose prior if prophylactic.",
                    "DOACs: 48 hours.",
                    "Plavix: 5 days.",
                    "Aspirin: 5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm target side, collecting system access, labs, anticoagulation holds, antibiotics, NPO status, and sedation tolerance."
            },
            {
              "type": "list",
              "items": [
                "Confirm indication, side, and intended nephrostomy tube endpoint.",
                "Review CT/US for hydronephrosis, collecting system target, stone/mass level, and safe posterior calyx access.",
                "Labs are appropriate.",
                "Anticoagulation appropriately held.",
                "Appropriate percutaneous access window.",
                "Antibiotics are ordered when infected/obstructed system, pyonephrosis, or sepsis is suspected.",
                "Patient is NPO if moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Key anatomy and landmarks for this procedure."
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "To build out",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Add procedure-specific target anatomy, access route anatomy, structures to avoid, and important imaging landmarks."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Procedure-specific access, device, imaging, and completion steps."
            },
            {
              "type": "heading",
              "text": "Troubleshooting"
            },
            {
              "type": "paragraph",
              "text": "Common nephrostomy tube placement problems and first checks."
            },
            {
              "type": "list",
              "items": [
                "No safe access window.",
                "Difficult collecting system access.",
                "Nondilated collecting system.",
                "Bloody urine.",
                "Tube obstruction.",
                "Tube dislodgement or leakage."
              ]
            },
            {
              "type": "heading",
              "text": "Red Flags"
            },
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Findings that should pause the case or prompt urgent escalation."
                },
                {
                  "type": "heading",
                  "text": "Escalate if"
                },
                {
                  "type": "list",
                  "items": [
                    "Sepsis or unstable vitals.",
                    "No safe access window.",
                    "Uncorrected high-risk anticoagulation issue.",
                    "Concern for vascular, bowel, pleural, or solid-organ injury.",
                    "Heavy hematuria, clot obstruction, or hemodynamic change after access.",
                    "Clinical deterioration after decompression."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Diet, vitals, pain control, urine output/drain care, flush orders, anticoagulation restart, AVS, and follow-up."
        },
        {
          "type": "heading",
          "text": "Drain care"
        },
        {
          "type": "list",
          "items": [
            "Confirm tube is to gravity drainage unless the operator gives a different plan.",
            "Track output, urine color, fever, flank pain, and ability to flush before discharge.",
            "Expect transient hematuria; escalate for heavy persistent bleeding, clots with obstruction, hypotension, or falling hemoglobin."
          ]
        },
        {
          "type": "heading",
          "text": "Follow up"
        },
        {
          "type": "list",
          "items": [
            "Routine exchange/check in 3 months unless infection, malfunction, or urology plan requires earlier follow-up."
          ]
        },
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "Regular diet.",
            "Vital signs per unit routine.",
            "Tylenol 650 mg PRN.",
            "Drain flush: 10 mL BID while admitted, 10 mL daily while outpatient."
          ]
        },
        {
          "type": "checklist",
          "title": "Anticoagulation to resume",
          "items": [
            "Warfarin: 24 hours postop.",
            "Heparin: 6-8 hours postop.",
            "Lovenox: 12 hours postop.",
            "DOACs: 24 hours postop.",
            "Plavix: 6 hours postop (75 mg) or 24 hours postop (300-600 mg).",
            "Aspirin: 24 hours postop."
          ]
        },
        {
          "type": "checklist",
          "title": "If outpatient",
          "items": [
            "Discharge order with medication reconciliation.",
            "After visit summary: .IRAVSPCN1."
          ]
        }
      ]
    }
  ]
