{
  "schemaVersion": 1,
  "id": "gastrostomy-gastrojejunostomy-jejunostomy-tube-placement",
  "title": "Gastrostomy/Gastrojejunostomy/Jejunostomy Tube Placement",
  "category": "drain-tube",
  "status": "complete",
  "bleedRisk": "high",
  "keywords": [
    "g",
    "tube",
    "gj",
    "j",
    "feeding",
    "peg"
  ],
  "summary": "Gastrostomy/gastrojejunostomy tube placement guidance for long-term enteral nutrition, dysphagia, aspiration risk, gastroparesis, and failed gastric feeding.",
  "lastReviewed": null,
  "provenance": [
    "Imported from procedure orders PDF updated 4.15.26"
  ],
  "reviewNotes": [
    "Confirm high bleeding risk classification with local policy.",
    "Confirm anticoagulation hold times with the final table.",
    "Confirm barium and NG tube workflow.",
    "Confirm POD1 clearance and nutrition consult workflow."
  ],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "order-set",
          "title": "Order set",
          "blocks": [
            {
              "type": "checklist",
              "items": [
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        },
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Gastrostomy versus gastrojejunostomy indications."
            },
            {
              "type": "heading",
              "text": "Gastrostomy"
            },
            {
              "type": "list",
              "items": [
                "Long-term enteral nutrition with inadequate oral intake.",
                "Persistent dysphagia.",
                "Planning for oropharyngeal surgery."
              ]
            },
            {
              "type": "heading",
              "text": "Gastrojejunostomy"
            },
            {
              "type": "list",
              "items": [
                "Gastric feeding not tolerated.",
                "High aspiration risk.",
                "Gastroparesis.",
                "Gastric outlet obstruction.",
                "Failed G-tube."
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50k."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High bleeding risk; hold anticoagulants/antiplatelets per policy."
                },
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: 5 days.",
                    "Heparin: 6-8 hours.",
                    "Lovenox: 24 hours; hold 1 dose prior if prophylactic.",
                    "DOACs: 48 hours.",
                    "Plavix: 5 days.",
                    "Aspirin: 5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Moderate or general anesthesia; general is common due to dysphagia indication."
            },
            {
              "type": "list",
              "items": [
                "Moderate or General.",
                "More often than others, these patients need general due to placement for dysphagia.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "physical-exam",
          "title": "Physical exam",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm target skin site is usable."
            },
            {
              "type": "list",
              "items": [
                "Target skin site without active infection or overlying medical machinery, such as leads, pacers, etc."
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Confirm indication, imaging, labs, access window, NPO status, barium, NG tube if inpatient, and antibiotics."
            },
            {
              "type": "list",
              "items": [
                "Confirm indication and review imaging.",
                "Labs are appropriate.",
                "Appropriate window on imaging.",
                "Patient is NPO if moderate sedation.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                "Barium order to be administered ENTIRE bottle the night prior.",
                "NG tube in place if inpatient.",
                "Ancef 2 g if <120 kg, 3 g if >120 kg."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Key anatomy and landmarks for this procedure."
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "To build out",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Add procedure-specific target anatomy, access route anatomy, structures to avoid, and important imaging landmarks."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Procedure-specific access, device, imaging, and completion steps."
            },
            {
              "type": "heading",
              "text": "Troubleshooting"
            },
            {
              "type": "paragraph",
              "text": "Common problems during or after tube placement and what to check first."
            },
            {
              "type": "heading",
              "text": "If no safe window"
            },
            {
              "type": "list",
              "items": [
                "Re-review CT/US/fluoro anatomy, reposition patient, insufflate stomach if appropriate, and reassess colon/liver interposition.",
                "Escalate to senior operator if anatomy is unfavorable or if surgical/endoscopic access may be safer."
              ]
            },
            {
              "type": "heading",
              "text": "If tube position is uncertain"
            },
            {
              "type": "list",
              "items": [
                "Do not clear for use until intraluminal position is confirmed.",
                "Use contrast confirmation and review images with the operator if there is concern for malposition."
              ]
            },
            {
              "type": "heading",
              "text": "If early pain or leakage"
            },
            {
              "type": "list",
              "items": [
                "Assess vitals, abdominal exam, tube position, dressing, and output.",
                "Escalate for peritonitis, severe pain, fever, or hemodynamic change."
              ]
            },
            {
              "type": "heading",
              "text": "Red Flags"
            },
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Findings that should pause the case or prompt urgent escalation."
                },
                {
                  "type": "heading",
                  "text": "Before placement"
                },
                {
                  "type": "list",
                  "items": [
                    "No safe percutaneous window, uncontrolled coagulopathy per local policy, active abdominal wall infection at access site, inability to consent without surrogate, or unstable patient for planned sedation.",
                    "Large-volume ascites, suspected peritonitis, severe ileus/obstruction, or anatomy altered enough that percutaneous access may be unsafe."
                  ]
                },
                {
                  "type": "heading",
                  "text": "After placement"
                },
                {
                  "type": "list",
                  "items": [
                    "Severe or worsening abdominal pain, peritoneal signs, fever, hypotension, bleeding, respiratory deterioration, tube dislodgement, or concern for intraperitoneal placement.",
                    "Do not use tube until cleared according to the post-procedure plan."
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Diet hold until IR clearance, vitals, pain control, pull-type antibiotic course, feeding clearance, and follow-up."
        },
        {
          "type": "heading",
          "text": "Follow up"
        },
        {
          "type": "list",
          "items": [
            "POD1 check with no signs of peritonitis.",
            "Flushes without resistance or pain.",
            "Nutrition consult.",
            "6 month routine exchange for balloon retention device."
          ]
        },
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "No diet until cleared by IR on POD1.",
            "Vital signs per unit routine.",
            "Tylenol 650 mg PRN.",
            "IF PULL TYPE: 500 mg Keflex BID x 5 days."
          ]
        },
        {
          "type": "checklist",
          "title": "Once cleared by IR",
          "items": [
            "Feeding tube: PEG and G Tube diet."
          ]
        },
        {
          "type": "checklist",
          "title": "Anticoagulation to resume",
          "items": [
            "Warfarin: 24 hours postop.",
            "Heparin: 6-8 hours postop.",
            "Lovenox: 12 hours postop.",
            "DOACs: 24 hours postop.",
            "Plavix: 6 hours postop (75 mg) or 24 hours postop (300-600 mg).",
            "Aspirin: 24 hours postop.",
            "Confirm no procedure-related bleeding concern and defer to local policy/attending preference."
          ]
        }
      ]
    }
  ]
}
