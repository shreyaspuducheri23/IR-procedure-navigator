  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Selected small renal masses for local treatment after multidisciplinary review.",
                "Patients unsuitable for surgery or choosing ablation after discussion of alternatives."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Uncorrectable coagulopathy or uncontrolled infection.",
                    "No safe probe path or inability to protect adjacent structures.",
                    "Insufficient renal reserve or inability to tolerate the planned procedure (relative)."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: hold 5 days and confirm INR <= 1.8.",
                    "IV unfractionated heparin: hold 4-6 hours and check aPTT or anti-Xa.",
                    "Enoxaparin: hold 1 dose if prophylactic; hold 2 doses or 24 hours if therapeutic.",
                    "DOACs: use agent- and CrCl-specific timing in the anticoagulation table.",
                    "Clopidogrel: hold 5 days.",
                    "Aspirin: hold 3-5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50,000/µL."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "SDC/Outpatient with Discharge.",
                "NPO if moderate sedation or anesthesia.",
                "Peripheral line placement.",
                "Vital signs per routine.",
                "Glucose point of care.",
                "CBC day of procedure.",
                "INR and BMP within 30 days."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " Moderate sedation or general anesthesia, depending on positioning, tolerance, and complexity."
                ],
                [
                  {
                    "link": {
                      "text": "Open moderate sedation checklist",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication."
                  },
                  ""
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " target size/location, collecting system, bowel, and safe probe paths."
                ],
                [
                  {
                    "strong": "Confirm pathology:"
                  },
                  " renal mass biopsy before (preferred) or at ablation; review renal function and solitary-kidney status."
                ],
                [
                  {
                    "strong": "Confirm ablation plan:"
                  },
                  " modality, probe configuration, treatment margin, and protection of nearby structures."
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " confirm results meet procedure-specific requirements when indicated; see the Labs tab."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm the procedure-specific hold/continue plan; see the Anticoagulation tab."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " discuss the procedure and patient-specific risks; identify a surrogate if needed."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
            {
              "type": "heading",
              "text": "Procedure"
            },
            {
              "type": "list",
              "items": [
                "Kidney Ablation"
              ]
            },
            {
              "type": "heading",
              "text": "Common risks"
            },
            {
              "type": "list",
              "items": [
                "Infection.",
                "Bleeding.",
                "Injury to nearby structures.",
                "Need for repeat treatment."
              ]
            },
            {
              "type": "heading",
              "text": "Procedure-specific risks"
            },
            {
              "type": "list",
              "items": [
                "Collecting-system injury or urine leak.",
                "Reduced renal function."
              ]
            },
            {
              "type": "heading",
              "text": "Consent discussion"
            },
            {
              "type": "list",
              "items": [
                "Discuss the expected benefit, alternatives, and patient-specific risks. This risk summary supports the discussion and institutional consent form; it is not an exhaustive consent document."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Target:"
                  },
                  " cortical versus central/hilar location; relationship to the renal sinus and collecting system."
                ],
                [
                  {
                    "strong": "Nearby structures:"
                  },
                  " bowel, ureter, renal vessels, psoas/genitofemoral nerve, and pleura for upper-pole targets."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "callout",
              "variant": "note",
              "title": "Quick steps",
              "collapsible": true,
              "defaultOpen": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic steps"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Position and plan:"
                      },
                      " confirm the target on CT/US and select safe probe paths."
                    ],
                    [
                      {
                        "strong": "2. Prep and protect:"
                      },
                      " prep, drape, and anesthetize; protect bowel and ureter/collecting system; use displacement or cooling when indicated."
                    ],
                    [
                      {
                        "strong": "3. Place probes:"
                      },
                      " advance under imaging and confirm configuration across the target and planned margin."
                    ],
                    [
                      {
                        "strong": "4. Ablate:"
                      },
                      " use the selected device protocol; monitor probe position and treatment coverage; for cryoablation, follow ice-ball growth and complete the planned thaw before probe removal."
                    ],
                    [
                      {
                        "strong": "5. Reassess:"
                      },
                      " confirm target coverage and assess for bleeding or adjacent-organ injury; treat residual target if safe."
                    ],
                    [
                      {
                        "strong": "6. Finish:"
                      },
                      " remove probes per device protocol, confirm hemostasis, and save final imaging."
                    ]
                  ]
                }
              ]
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "Detailed steps",
              "collapsible": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Content pending."
                }
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Central targets:"
                      },
                      " review collecting-system and ureter proximity; arrange protection when needed."
                    ],
                    [
                      {
                        "strong": "Cryoablation:"
                      },
                      " the visible ice-ball edge is not the lethal margin; reassess coverage and nearby structures."
                    ],
                    [
                      {
                        "strong": "Renal injury:"
                      },
                      " watch for hematuria, bleeding, and reduced renal function."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "link": {
                          "text": "AUA renal mass guideline",
                          "href": "https://www.auanet.org/documents/Guidelines/PDF/Renal-Mass-Guideline.pdf"
                        }
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "Notify MD/LIP - IR.",
            "Diet - Outpatient: order regular diet. Inpatient: notify primary team diet is okay.",
            "Vital signs every 15 minutes x 4, then every 30 minutes x 2, then every 1 hour x 1.",
            "Tylenol 650 mg PRN.",
            "Oxycodone PRN per pain scale.",
            "Zofran 4 mg IV PRN."
          ]
        },
        {
          "type": "checklist",
          "title": "Access care",
          "items": [
            "Wound care/treatment."
          ]
        },
        {
          "type": "checklist",
          "title": "Anticoagulation to resume",
          "items": [
            "Warfarin: 24 hours.",
            "IV unfractionated heparin: 6-8 hours.",
            "Enoxaparin: 12 hours.",
            "DOACs: Typically 24 hours; confirm agent and renal function.",
            "Clopidogrel: 75 mg dose - 6 hours; 300-600 mg loading dose - 24 hours.",
            "Aspirin: 24 hours.",
            "Restart after hemostasis is confirmed; individualize timing for procedure-specific or patient-specific exceptions."
          ]
        },
        {
          "type": "checklist",
          "title": "Discharge",
          "items": [
            "Discharge order with medication reconciliation - 3 hours.",
            "After visit summary: .IRAVSRENALABLATION."
          ]
        },
        {
          "type": "checklist",
          "title": "Follow up",
          "items": [
            "Clinic in 1 month with CT/MRI renal mass."
          ]
        }
      ]
    }
