    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Superficial nodes:"
                  },
                  " cervical, supraclavicular, axillary, and inguinal targets; confirm side and level."
                ],
                [
                  {
                    "strong": "Nearby structures:"
                  },
                  " map vessels with Doppler; avoid nerves, salivary glands, and pleura near supraclavicular targets."
                ],
                [
                  {
                    "strong": "Sampling target:"
                  },
                  " choose viable solid tissue and avoid necrotic areas and hilar vessels."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "callout",
              "variant": "note",
              "title": "Quick steps",
              "collapsible": true,
              "defaultOpen": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic steps"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Confirm the target:"
                      },
                      " match the node and side to imaging and the request."
                    ],
                    [
                      {
                        "strong": "2. Position and scan:"
                      },
                      " map vessels with Doppler and choose a safe, visible needle path."
                    ],
                    [
                      {
                        "strong": "3. Prep and anesthetize:"
                      },
                      " use sterile technique and local anesthesia."
                    ],
                    [
                      {
                        "strong": "4. Sample under ultrasound:"
                      },
                      " keep the needle tip visible; confirm a safe throw if using core biopsy."
                    ],
                    [
                      {
                        "strong": "5. Handle specimens:"
                      },
                      " send for requested studies; confirm adequacy with cytology when available."
                    ],
                    [
                      {
                        "strong": "6. Apply pressure and reassess:"
                      },
                      " confirm hemostasis and place a dressing."
                    ]
                  ]
                }
              ]
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "Detailed steps",
              "collapsible": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Tools needed"
                },
                {
                  "type": "list",
                  "items": [
                    "Small-gauge needles, typically 25G.",
                    "Lidocaine.",
                    "Sterile drapes and towels.",
                    "Specimen cups.",
                    "Ultrasound probe and sterile cover.",
                    "Sterile gloves and gown."
                  ]
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Image and plan:"
                      },
                      " before sterile prep, scan with ultrasound and gel. Plan a trajectory avoiding major structures and vessels, then mark the skin entry site."
                    ],
                    [
                      {
                        "strong": "2. Prep and drape:"
                      },
                      " remove the gel, clean and prep the site, then place sterile blue drapes."
                    ],
                    [
                      {
                        "strong": "3. Anesthetize:"
                      },
                      " infiltrate lidocaine along the planned needle tract to the target."
                    ],
                    [
                      {
                        "strong": "4. Position the FNA needle:"
                      },
                      " under ultrasound guidance, advance a typically 25G needle into the lymph node, keeping the tip visible."
                    ],
                    [
                      {
                        "strong": "5. Obtain samples:"
                      },
                      " make short, controlled back-and-forth motions within the node, up to 15-20 motions per needle. Gentle rotation while advancing and retracting may help. Repeat with additional needles and submit specimens per the planned studies."
                    ],
                    [
                      {
                        "strong": "6. Finish:"
                      },
                      " remove the needle, apply pressure, clean the site, and place a bandage. Save a post-procedure ultrasound image."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Wrong node:"
                      },
                      " confirm the requested target and laterality before sampling."
                    ],
                    [
                      {
                        "strong": "Nondiagnostic tissue:"
                      },
                      " avoid necrosis; coordinate core versus FNA and specimen handling with pathology."
                    ],
                    [
                      {
                        "strong": "Suspected lymphoma:"
                      },
                      " arrange fresh tissue for flow cytometry per lab protocol; do not place all tissue in formalin. Excision may be needed if needle biopsy is insufficient."
                    ],
                    [
                      {
                        "strong": "Lost needle tip:"
                      },
                      " stop and regain visualization before advancing or sampling."
                    ],
                    [
                      {
                        "strong": "Bleeding or neck swelling:"
                      },
                      " apply pressure; expanding hematoma, dysphagia, or dyspnea requires urgent assessment."
                    ]
                  ]
                },
