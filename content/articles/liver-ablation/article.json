  ],
  "reviewNotes": [],
  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Selected HCC or liver metastases for local treatment after multidisciplinary review.",
                "Residual or recurrent focal tumor suitable for ablation."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Uncorrectable coagulopathy or uncontrolled infection.",
                    "No safe probe path or inability to protect adjacent structures.",
                    "Insufficient liver reserve or inability to tolerate the planned procedure (relative)."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "High bleeding risk.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: hold 5 days and confirm INR <= 1.8.",
                    "IV unfractionated heparin: hold 4-6 hours and check aPTT or anti-Xa.",
                    "Enoxaparin: hold 1 dose if prophylactic; hold 2 doses or 24 hours if therapeutic.",
                    "DOACs: use agent- and CrCl-specific timing in the anticoagulation table.",
                    "Clopidogrel: hold 5 days.",
                    "Aspirin: hold 3-5 days."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "list",
              "items": [
                "INR < 1.5-1.8.",
                "Platelets >50,000/µL."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "heading",
              "text": "Routine orders"
            },
            {
              "type": "list",
              "items": [
                "SDC/Outpatient with Discharge.",
                "NPO if moderate sedation or anesthesia.",
                "Peripheral line placement.",
                "Vital signs per routine.",
                "Glucose point of care.",
                "Cefazolin (Ancef) 2 g if <120 kg; 3 g if >120 kg. Confirm dose at 120 kg per protocol.",
                "Metronidazole (Flagyl) 500 mg IV.",
                "CBC, INR, CMP, and AFP if HCC - day of procedure."
              ]
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Preferred:"
                  },
                  " Moderate sedation or general anesthesia, depending on target location, breath-hold needs, and complexity."
                ],
                [
                  {
                    "link": {
                      "text": "Open moderate sedation checklist",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ]
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Confirm indication."
                  },
                  ""
                ],
                [
                  {
                    "strong": "Verify labs:"
                  },
                  " See the Labs tab."
                ],
                [
                  {
                    "strong": "Review anticoagulation:"
                  },
                  " confirm the procedure-specific hold/continue plan; see the Anticoagulation tab."
                ],
                [
                  {
                    "strong": "Review imaging:"
                  },
                  " target visibility, bile ducts/vessels, adjacent bowel, and safe probe paths."
                ],
                [
                  {
                    "strong": "Review liver reserve:"
                  },
                  " bilirubin, liver function, prior biliary intervention/anastomosis, and infection risk."
                ],
                [
                  {
                    "strong": "Confirm ablation plan:"
                  },
                  " modality, probe configuration, treatment margin, and protection of nearby structures."
                ],
                [
                  {
                    "strong": "Confirm sedation plan:"
                  },
                  " review the planned method, ability to lie flat/tolerate procedural positioning, and NPO status if sedation/anesthesia is planned."
                ],
                [
                  {
                    "strong": "Confirm consent:"
                  },
                  " discuss the procedure and patient-specific risks; identify a surrogate if needed."
                ]
              ]
            }
          ]
        },
        {
          "id": "consent",
          "title": "Consent",
          "blocks": [
            {
              "type": "heading",
              "text": "Procedure"
            },
            {
              "type": "list",
              "items": [
                "Liver Ablation"
              ]
            },
            {
              "type": "heading",
              "text": "Common risks"
            },
            {
              "type": "list",
              "items": [
                "Infection.",
                "Bleeding.",
                "Injury to nearby structures.",
                "Need for repeat treatment."
              ]
            },
            {
              "type": "heading",
              "text": "Procedure-specific risks"
            },
            {
              "type": "list",
              "items": [
                "Bile duct injury or bile leak.",
                "Liver abscess or decompensation."
              ]
            },
            {
              "type": "heading",
              "text": "Consent discussion"
            },
            {
              "type": "list",
              "items": [
                "Discuss the expected benefit, alternatives, and patient-specific risks. This risk summary supports the discussion and institutional consent form; it is not an exhaustive consent document."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Target:"
                  },
                  " confirm segment and relationship to portal/hepatic veins and major bile ducts."
                ],
                [
                  {
                    "strong": "Nearby structures:"
                  },
                  " gallbladder, bowel, stomach, diaphragm, and pleura; plan protection when needed."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "callout",
              "variant": "note",
              "title": "Quick steps",
              "collapsible": true,
              "defaultOpen": true,
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic steps"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "1. Position and plan:"
                      },
                      " confirm the target on CT/US and select safe probe paths."
                    ],
                    [
                      {
                        "strong": "2. Prep and protect:"
                      },
                      " prep, drape, and anesthetize; protect bowel, gallbladder, diaphragm, and central bile ducts; use displacement when indicated."
                    ],
                    [
                      {
                        "strong": "3. Place probes:"
                      },
                      " advance under imaging and confirm configuration across the target and planned margin."
                    ],
                    [
                      {
                        "strong": "4. Ablate:"
                      },
                      " use the selected device protocol; monitor treatment coverage and nearby structures; account for vessel-related heat sink with heat-based ablation."
                    ],
                    [
                      {
                        "strong": "5. Reassess:"
                      },
                      " confirm target coverage and assess for bleeding or adjacent-organ injury; treat residual target if safe."
                    ],
                    [
                      {
                        "strong": "6. Finish:"
                      },
                      " remove probes per device protocol, confirm hemostasis, and save final imaging."
                    ]
                  ]
                }
              ]
            },
            {
              "type": "callout",
              "variant": "note",
              "title": "Detailed steps",
              "collapsible": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Content pending."
                }
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Biliary infection risk:"
                      },
                      " prior biliary-enteric anastomosis or instrumentation warrants an individualized antibiotic plan."
                    ],
                    [
                      {
                        "strong": "Central bile ducts:"
                      },
                      " avoid unprotected thermal injury; reconsider modality or treatment plan if unsafe."
                    ],
                    [
                      {
                        "strong": "Incomplete coverage:"
                      },
                      " account for heat sink and confirm the planned margin."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "link": {
                          "text": "CIRSE standards: thermal ablation of liver tumours",
                          "href": "https://pubmed.ncbi.nlm.nih.gov/32382856/"
                        }
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "post",
      "kind": "post",
      "title": "Post-procedure",
      "blocks": [
        {
          "type": "checklist",
          "title": "Routine orders",
          "items": [
            "Notify MD/LIP - IR.",
            "Diet - Outpatient: order regular diet. Inpatient: notify primary team diet is okay.",
            "Vital signs every 15 minutes x 4, then every 30 minutes x 2, then every 1 hour x 1.",
            "Tylenol 650 mg PRN.",
            "Oxycodone PRN per pain scale.",
            "Zofran 4 mg IV PRN."
          ]
        },
        {
          "type": "checklist",
          "title": "Access care",
          "items": [
            "Wound care/treatment."
          ]
        },
        {
          "type": "checklist",
          "title": "Anticoagulation to resume",
          "items": [
            "Warfarin: 24 hours.",
            "IV unfractionated heparin: 6-8 hours.",
            "Enoxaparin: 12 hours.",
            "DOACs: Typically 24 hours; confirm agent and renal function.",
            "Clopidogrel: 75 mg dose - 6 hours; 300-600 mg loading dose - 24 hours.",
            "Aspirin: 24 hours.",
            "Restart after hemostasis is confirmed; individualize timing for procedure-specific or patient-specific exceptions."
          ]
        },
        {
          "type": "checklist",
          "title": "Discharge",
          "items": [
            "Discharge order with medication reconciliation - 3 hours.",
            "After visit summary: .IRAVSABLATIONLIVER1."
          ]
        },
        {
          "type": "checklist",
          "title": "Follow up",
          "items": [
            "Clinic in 1 month with MRI liver mass and CBC, INR, CMP, and AFP if HCC."
          ]
        }
      ]
    }
  ]
