      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Remove when therapy is complete, the port is no longer needed, or there is infection, malfunction, thrombosis, fracture, or migration."
              ]
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Therapy completed.",
                "Port no longer needed.",
                "Infection.",
                "Malfunction.",
                "Thrombosis, fracture, or migration."
              ]
            },
            {
              "type": "heading",
              "text": "Contraindications"
            },
            {
              "type": "callout",
              "variant": "contraindication",
              "title": "Contraindications",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Unmanageable bleeding risk (relative; weigh infection/source-control urgency).",
                    "Adherent or fractured catheter: stop routine traction and arrange advanced retrieval.",
                    "Ongoing access need requires a replacement plan, not automatic cancellation of removal."
                  ]
                }
              ]
            }
          ]
        },
