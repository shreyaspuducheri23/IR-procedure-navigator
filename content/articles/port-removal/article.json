  "sections": [
    {
      "id": "pre",
      "kind": "pre",
      "title": "Pre-procedure",
      "subsections": [
        {
          "id": "indication",
          "title": "Indication",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Remove when therapy is complete, the port is no longer needed, or there is infection, malfunction, thrombosis, fracture, or migration."
            },
            {
              "type": "heading",
              "text": "Indications"
            },
            {
              "type": "list",
              "items": [
                "Therapy completed.",
                "Port no longer needed.",
                "Infection.",
                "Malfunction.",
                "Thrombosis, fracture, or migration."
              ]
            }
          ]
        },
        {
          "id": "anticoagulation",
          "title": "Anticoagulation",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    "Low bleeding-risk procedure.",
                    [
                      {
                        "link": {
                          "text": "Open anticoagulation table",
                          "articleId": "anticoagulation-table"
                        }
                      }
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "Hold"
                },
                {
                  "type": "list",
                  "items": [
                    "Warfarin: no holding requirement.",
                    "Heparin: no holding requirement.",
                    "Lovenox: no holding requirement.",
                    "DOACs: no holding requirement.",
                    "Plavix: no holding requirement.",
                    "Aspirin: no holding requirement."
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "labs",
          "title": "Labs",
          "blocks": [
            {
              "type": "paragraph",
              "text": "INR < 2-3 and platelets >20k."
            },
            {
              "type": "list",
              "items": [
                "Platelets >20,000/uL.",
                "INR < 2-3."
              ]
            }
          ]
        },
        {
          "id": "pre-procedure-orders",
          "title": "Pre-procedure orders",
          "blocks": [
            {
              "type": "paragraph",
              "text": "Procedure-specific pre-procedure orders have not yet been documented in this guide."
            }
          ]
        },
        {
          "id": "sedation",
          "title": "Sedation",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Local anesthesia.",
                "Moderate sedation, optional.",
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                "General anesthesia for select pediatric or complex removals."
              ]
            }
          ]
        },
        {
          "id": "checklist",
          "title": "Checklist",
          "blocks": [
            {
              "type": "list",
              "items": [
                "Confirm indication.",
                "Review port location and prior imaging.",
                "Assess for pocket infection or bacteremia.",
                "Labs are appropriate.",
                "Determine whether catheter-tip culture is needed.",
                "Confirm sedation plan - patient can lie flat."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "intra",
      "kind": "intra",
      "title": "Intra-procedure",
      "subsections": [
        {
          "id": "anatomy",
          "title": "Anatomy",
          "blocks": [
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "Pocket capsule:"
                  },
                  " fibrous tissue and fixation sutures may tether the reservoir."
                ],
                [
                  {
                    "strong": "Catheter course:"
                  },
                  " identify the connector and tunnel before dissection to avoid cutting the catheter."
                ],
                [
                  {
                    "strong": "Venous attachment:"
                  },
                  " long-standing catheters can adhere centrally; resistance may reflect more than pocket scarring."
                ]
              ]
            }
          ]
        },
        {
          "id": "procedural-steps",
          "title": "Procedural steps",
          "blocks": [
            {
              "type": "heading",
              "text": "Basic steps"
            },
            {
              "type": "list",
              "items": [
                [
                  {
                    "strong": "1. Assess the pocket"
                  },
                  " for infection or erosion and confirm the device and reason for removal."
                ],
                [
                  {
                    "strong": "2. Prep, anesthetize, and reopen"
                  },
                  " the pocket; release fixation sutures and free the reservoir with controlled dissection."
                ],
                [
                  {
                    "strong": "3. Withdraw the system gently"
                  },
                  " maintaining control of the catheter; use positioning and breathing precautions per local central-line removal protocol."
                ],
                [
                  {
                    "strong": "4. Inspect and manage the wound"
                  },
                  " confirm the entire catheter is intact, obtain hemostasis, and close a clean pocket; infected pockets need a tailored culture and wound-care plan."
                ]
              ]
            }
          ]
        },
        {
          "id": "pitfalls-and-safety",
          "title": "Pitfalls and safety",
          "blocks": [
            {
              "type": "callout",
              "variant": "caution",
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "strong": "Stuck catheter:"
                      },
                      " stop forceful traction; assess under imaging and plan further removal with experienced support."
                    ],
                    [
                      {
                        "strong": "Fracture or embolization:"
                      },
                      " avoid sharp dissection against the catheter; a missing segment requires localization and a retrieval plan."
                    ],
                    [
                      {
                        "strong": "Air entry or bleeding:"
                      },
                      " promptly compress and occlude the tract after withdrawal, then apply an occlusive dressing."
                    ],
                    [
                      {
                        "strong": "Pocket infection:"
                      },
                      " do not routinely close over purulence; arrange drainage, wound care, and antimicrobial management."
                    ]
                  ]
                },
                {
                  "type": "heading",
                  "text": "References"
                },
                {
                  "type": "list",
                  "items": [
                    [
                      {
                        "link": {
                          "text": "JSIR Guidelines for Central Venous Port Placement and Management",
                          "href": "https://www.jstage.jst.go.jp/article/interventionalradiology/8/2/8_2022-0015/_article"
                        }
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
