                ],
                [
                  {
                    "strong": "Alternative:"
                  },
                  " moderate sedation in selected patients."
                ],
                [
                  {
                    "link": {
                      "text": "Can tolerate moderate sedation",
                      "articleId": "moderate-sedation-checklist"
                    }
                  }
                ],
                [
                  {
